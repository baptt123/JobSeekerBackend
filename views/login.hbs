<html lang='vi'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />

    <title>{{title}}</title>

    <script src='https://cdn.tailwindcss.com'></script>
    <script>
      // 2. Cấu hình Tailwind để thêm màu tùy chỉnh tailwind.config = { theme: {
      extend: { colors: { // Đây là màu xanh cyan/teal chính trong thiết kế của
      bạn 'custom-cyan': '#26C6DA', } } } }
    </script>
  </head>
  <body class='bg-white font-sans relative min-h-screen overflow-hidden'>

    <div class='absolute bottom-0 right-0 z-0 overflow-hidden'>
      <svg
        class='w-[500px] h-[500px] text-custom-cyan opacity-5 transform translate-x-1/4 translate-y-1/4'
        viewBox='0 0 54 54'
        fill='currentColor'
        xmlns='http://www.w3.org/2000/svg'
      >
        <path
          d='M18.9 9.5625C18.9 14.8519 14.5419 19.125 9.16667 19.125C14.5419 19.125 18.9 23.3981 18.9 28.6875V44.4375H13.5V28.6875C13.5 25.3342 10.8325 22.625 7.5 22.625C10.8325 22.625 13.5 19.9158 13.5 16.5625V9.5625H18.9Z'
        />
        <path
          d='M35.1 9.5625C35.1 14.8519 39.4581 19.125 44.8333 19.125C39.4581 19.125 35.1 23.3981 35.1 28.6875V44.4375H40.5V28.6875C40.5 25.3342 43.1675 22.625 46.5 22.625C43.1675 22.625 40.5 19.9158 40.5 16.5625V9.5625H35.1Z'
        />
      </svg>
    </div>

    <div
      class='relative z-10 flex flex-col items-center justify-center min-h-screen px-6 py-8 mx-auto'
    >
      <div class='w-full max-w-sm'>

        <div class='flex justify-center mb-6'>
          <svg
            class='w-16 h-16 text-custom-cyan'
            viewBox='0 0 54 54'
            fill='currentColor'
            xmlns='http://www.w3.org/2000/svg'
          >
            <path
              d='M18.9 9.5625C18.9 14.8519 14.5419 19.125 9.16667 19.125C14.5419 19.125 18.9 23.3981 18.9 28.6875V44.4375H13.5V28.6875C13.5 25.3342 10.8325 22.625 7.5 22.625C10.8325 22.625 13.5 19.9158 13.5 16.5625V9.5625H18.9Z'
            />
            <path
              d='M35.1 9.5625C35.1 14.8519 39.4581 19.125 44.8333 19.125C39.4581 19.125 35.1 23.3981 35.1 28.6875V44.4375H40.5V28.6875C40.5 25.3342 43.1675 22.625 46.5 22.625C43.1675 22.625 40.5 19.9158 40.5 16.5625V9.5625H35.1Z'
            />
          </svg>
        </div>

        <h1 class='text-3xl font-bold text-gray-900 text-center mb-2'>
          Let's get you Login!
        </h1>
        <p class='text-base text-gray-500 text-center mb-6'>
          Enter your information below
        </p>

        <form class='space-y-6' action='#' method='POST'>

          <div class='grid grid-cols-2 gap-4'>
            <button
              type='button'
              class='flex items-center justify-center w-full px-4 py-3 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500'
            >
              <svg
                class='w-5 h-5 mr-2'
                role='img'
                viewBox='0 0 24 24'
                xmlns='http://www.w3.org/2000/svg'
              ><title>Google</title><path
                  d='M12.48 10.92v3.28h7.84c-.24 1.84-.85 3.18-1.78 4.13-1.02 1.08-2.58 2.03-4.56 2.03-3.86 0-7.01-3.23-7.01-7.23s3.15-7.23 7.01-7.23c2.11 0 3.61.87 4.49 1.78l2.6-2.59C18.01 1.02 15.5 0 12.48 0 5.61 0 0 5.6 0 12.5S5.61 25 12.48 25c7.23 0 11.97-5.02 11.97-12.12 0-.8-.08-1.5-.2-2.18h-11.77z'
                  fill='#4285F4'
                /></svg>
              Google
            </button>
            <button
              type='button'
              class='flex items-center justify-center w-full px-4 py-3 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500'
            >
              <svg
                class='w-5 h-5 mr-2'
                role='img'
                viewBox='0 0 24 24'
                xmlns='http://www.w3.org/2000/svg'
              ><title>Facebook</title><path
                  d='M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.67 4.533-4.67 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z'
                  fill='#1877F2'
                /></svg>
              Facebook
            </button>
          </div>

          <div class='flex items-center'>
            <span class='flex-grow bg-gray-200 h-px'></span>
            <span class='px-4 text-sm text-gray-400'>Or login with</span>
            <span class='flex-grow bg-gray-200 h-px'></span>
          </div>

          <div class='relative'>
            <span class='absolute inset-y-0 left-0 flex items-center pl-4'>
              <svg
                class='w-5 h-5 text-gray-400'
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75'
                />
              </svg>
            </span>
            <input
              type='email'
              name='email'
              id='email'
              class='block w-full px-12 py-4 text-gray-900 border border-gray-300 rounded-xl bg-white focus:ring-custom-cyan focus:border-custom-cyan'
              placeholder='Enter Email'
              required
            />
          </div>

          <div class='relative'>
            <span class='absolute inset-y-0 left-0 flex items-center pl-4'>
              <svg
                class='w-5 h-5 text-gray-400'
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z'
                />
              </svg>
            </span>
            <input
              type='password'
              name='password'
              id='password'
              class='block w-full px-12 py-4 text-gray-900 border border-gray-300 rounded-xl bg-white focus:ring-custom-cyan focus:border-custom-cyan'
              placeholder='Enter Password'
              required
            />
            <span class='absolute inset-y-0 right-0 flex items-center pr-4'>
              <svg
                class='w-5 h-5 text-gray-400 cursor-pointer hover:text-gray-600'
                xmlns='http://www.w3.org/2000/svg'
                fill='none'
                viewBox='0 0 24 24'
                stroke-width='1.5'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.864 7.864L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 00-4.243-4.243m4.243 4.243L12 12'
                />
              </svg>
            </span>
          </div>

          <div class='flex items-center justify-end'>
            <a
              href='#'
              class='text-sm font-medium text-custom-cyan hover:underline'
            >
              Forgot Password?
            </a>
          </div>

          <button
            type='submit'
            class='w-full text-white bg-custom-cyan hover:bg-custom-cyan/90 focus:ring-4 focus:outline-none focus:ring-custom-cyan/50 font-medium rounded-xl text-sm px-5 py-4 text-center'
          >
            Login
          </button>

          <p class='text-sm text-gray-500 text-center'>
            Don’t have an account?
            <a
              href='#'
              class='font-medium text-custom-cyan hover:underline'
            >Register Now</a>
          </p>
        </form>
      </div>
    </div>

  </body>
</html>