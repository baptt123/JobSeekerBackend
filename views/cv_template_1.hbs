<html>
  <head>
    <title>CV - {{cv.fullName}}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
      }
      .container {
        max-width: 800px;
        margin: 20px auto;
        background-color: #fff;
        padding: 40px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      h1 {
        color: #333;
        margin: 0 0 10px;
      }
      h2 {
        color: #555;
        margin: 0 0 20px;
        font-weight: normal;
      }
      .contact {
        margin-bottom: 20px;
      }
      .contact p {
        margin: 5px 0;
      }
      .section {
        margin-bottom: 30px;
      }
      .section h3 {
        border-bottom: 2px solid #333;
        padding-bottom: 5px;
        margin-bottom: 15px;
      }
      .job {
        margin-bottom: 15px;
      }
      .job h4 {
        margin: 0;
      }
      .job p {
        margin: 5px 0;
      }
      .skills li {
        display: inline-block;
        background-color: #eee;
        padding: 5px 10px;
        margin: 5px 5px 5px 0;
        border-radius: 5px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>{{cv.fullName}}</h1>
      <h2>{{cv.jobTitle}}</h2>

      <div class="contact">
        <p><strong>Email:</strong> {{cv.email}}</p>
        <p><strong>Phone:</strong> {{cv.phone}}</p>
        <p><strong>Address:</strong> {{cv.address}}</p>
      </div>

      <div class="section">
        <h3>Giới thiệu</h3>
        <p>{{cv.summary}}</p>
      </div>

      <div class="section">
        <h3>Kinh nghiệm làm việc</h3>
        {{#each cv.experiences}}
        <div class="job">
          <h4>{{this.jobTitle}} - {{this.company}}</h4>
          <p><i>{{this.duration}}</i></p>
          <p>{{this.description}}</p>
        </div>
        {{/each}}
      </div>

      <div class="section">
        <h3>Học vấn</h3>
        {{#each cv.educations}}
        <div class="job">
          <h4>{{this.school}}</h4>
          <p><strong>{{this.degree}}</strong> (<i>{{this.duration}}</i>)</p>
        </div>
        {{/each}}
      </div>

      <div class="section">
        <h3>Kỹ năng</h3>
        <ul class="skills">
          {{#each cv.skills}}
          <li>{{this.name}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </body>
</html>
