<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Quản lý Bình luận | TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>tailwind.config = { theme: { extend: { colors: { primary: '#6b26d9' } } } }</script>
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> recruiter_sidebar activePage='comments'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8">
    <h1 class="text-xl font-bold text-slate-800">Bình luận công việc</h1>
<!--    <span class="text-sm text-slate-500">Quản lý tương tác trên các bài đăng của bạn</span>-->
  </header>

  <div class="flex-1 overflow-y-auto p-8">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="p-4 text-sm font-semibold text-slate-600">Ứng viên</th>
          <th class="p-4 text-sm font-semibold text-slate-600">Nội dung bình luận</th>
          <th class="p-4 text-sm font-semibold text-slate-600">Công việc</th>
          <th class="p-4 text-sm font-semibold text-slate-600">Thời gian</th>
          <th class="p-4 text-sm font-semibold text-slate-600 text-right">Hành động</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
        {{#each comments}}
          <tr class="hover:bg-slate-50 transition group" id="comment-row-{{this.id}}">
            <td class="p-4 align-top">
              <div class="flex items-center gap-3">
                <img src="{{this.user.avatar_url}}" onerror="this.src='https://ui-avatars.com/api/?name={{this.user.full_name}}'" class="w-9 h-9 rounded-full object-cover border border-slate-200">
                <div>
                  <p class="font-medium text-slate-800 text-sm">{{this.user.full_name}}</p>
                  <p class="text-xs text-slate-500">{{this.user.email}}</p>
                </div>
              </div>
            </td>

            <td class="p-4 align-top">
              <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 inline-block max-w-lg text-sm text-slate-700 leading-relaxed">
                {{this.content}}
              </div>
            </td>

            <td class="p-4 align-top">
              <a href="/recruiter/jobs/{{this.job.job_id}}" target="_blank" class="text-sm text-indigo-600 hover:underline font-medium flex items-center gap-1">
                {{this.job.title}}
                <span class="material-symbols-outlined text-[14px]">open_in_new</span>
              </a>
            </td>

            <td class="p-4 align-top text-sm text-slate-500 whitespace-nowrap">
              {{formatDate this.createdAt}}
            </td>

            <td class="p-4 align-top text-right">
              <button onclick="deleteComment({{this.id}})" class="group/btn relative inline-flex items-center justify-center w-8 h-8 rounded-full hover:bg-red-50 text-slate-400 hover:text-red-500 transition">
                <span class="material-symbols-outlined text-[20px]">delete</span>
                <span class="absolute bottom-full mb-2 hidden group-hover/btn:block text-xs bg-gray-800 text-white px-2 py-1 rounded shadow-lg whitespace-nowrap z-10">Xóa</span>
              </button>
            </td>
          </tr>
        {{/each}}

        {{#unless comments}}
          <tr>
            <td colspan="5" class="py-20 text-center text-slate-400">
              <span class="material-symbols-outlined text-5xl mb-3 text-slate-300">chat_bubble_outline</span>
              <p class="text-lg font-medium text-slate-600">Chưa có bình luận nào</p>
              <p class="text-sm">Bình luận từ ứng viên trên các bài đăng của bạn sẽ xuất hiện ở đây.</p>
            </td>
          </tr>
        {{/unless}}
        </tbody>
      </table>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
  async function deleteComment(id) {
    const result = await Swal.fire({
      title: 'Xóa bình luận?',
      text: "Hành động này sẽ ẩn bình luận khỏi bài đăng. Bạn có chắc chắn không?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#94a3b8',
      confirmButtonText: 'Đồng ý xóa',
      cancelButtonText: 'Hủy bỏ',
      customClass: {
        popup: 'rounded-xl',
        confirmButton: 'rounded-lg px-6 py-2.5',
        cancelButton: 'rounded-lg px-6 py-2.5'
      }
    });

    if (result.isConfirmed) {
      try {
        // Gọi API Delete
        await axios.delete(`/recruiter/comments/${id}`);

        // Hiển thị Toast thành công
        Toastify({
          text: "✅ Đã xóa bình luận thành công",
          duration: 3000,
          gravity: "top",
          position: "right",
          stopOnFocus: true,
          style: {
            background: "linear-gradient(to right, #10b981, #059669)",
            boxShadow: "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
            borderRadius: "8px"
          }
        }).showToast();

        // Xóa dòng khỏi bảng ngay lập tức (hiệu ứng fade out)
        const row = document.getElementById(`comment-row-${id}`);
        if(row) {
          row.style.transition = "all 0.5s ease";
          row.style.opacity = "0";
          row.style.transform = "translateX(20px)";
          setTimeout(() => row.remove(), 500);
        }

      } catch (e) {
        console.error(e);
        const msg = e.response?.data?.message || "Lỗi hệ thống";

        Toastify({
          text: `❌ ${msg}`,
          duration: 3000,
          gravity: "top",
          position: "right",
          style: {
            background: "#ef4444",
            borderRadius: "8px"
          }
        }).showToast();
      }
    }
  }
</script>
</body>
</html>