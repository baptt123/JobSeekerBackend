<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Job Details - {{job.title}}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
  <script>
    tailwind.config = { theme: { extend: { colors: { "primary": "#6b26d9" } } } }
  </script>
</head>
<body class="bg-gray-50 font-sans">
<div class="flex min-h-screen">

  {{> recruiter_sidebar activePage='jobs'}}

  <main class="flex-1 p-8">
    <div class="mb-6">
      <a href="/recruiter/my-jobs" class="text-gray-500 hover:text-primary flex items-center gap-1 mb-2">
        <span class="material-symbols-outlined text-sm">arrow_back</span> Back to My Jobs
      </a>
      <div class="flex justify-between items-start">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">{{job.title}}</h1>
          <p class="text-gray-500 mt-1">Created at: {{job.created_at}}</p>
        </div>
        <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">Active</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
        <p class="text-gray-500 text-sm">Total Applicants</p>
        <p class="text-2xl font-bold text-gray-800">{{applications.length}}</p>
      </div>
      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
        <p class="text-gray-500 text-sm">Salary Range</p>
        <p class="text-lg font-bold text-gray-800">${{job.salary_min}} - ${{job.salary_max}}</p>
      </div>
      <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
        <p class="text-gray-500 text-sm">Job Type</p>
        <p class="text-lg font-bold text-gray-800">{{job.job_type}}</p>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="p-5 border-b border-gray-200 flex justify-between items-center">
        <h2 class="text-lg font-bold text-gray-800">Candidates</h2>
        <div class="flex gap-2">
          <input type="text" placeholder="Search candidate..." class="text-sm border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
        </div>
      </div>

      <table class="w-full text-left border-collapse">
        <thead class="bg-gray-50">
        <tr>
          <th class="p-4 text-sm font-semibold text-gray-600">Candidate</th>
          <th class="p-4 text-sm font-semibold text-gray-600">Applied Date</th>
          <th class="p-4 text-sm font-semibold text-gray-600">Status</th>
          <th class="p-4 text-sm font-semibold text-gray-600">CV</th>
          <th class="p-4 text-sm font-semibold text-gray-600 text-right">Actions</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
        {{#each applications}}
          <tr class="hover:bg-gray-50 group">
            <td class="p-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gray-200 bg-cover bg-center"
                     style="background-image: url('{{this.user.avatar_url}}')"></div>
                <div>
                  <p class="font-medium text-gray-900">{{this.user.full_name}}</p>
                  <p class="text-xs text-gray-500">{{this.user.email}}</p>
                </div>
              </div>
            </td>

            <td class="p-4 text-sm text-gray-600">{{this.applied_at}}</td>

            <td class="p-4">
                            <span class="px-2 py-1 rounded text-xs font-bold
                                {{#if (eq this.status 'Applied')}}bg-gray-100 text-gray-600{{/if}}
                              {{#if (eq this.status 'Interview')}}bg-blue-100 text-blue-600{{/if}}
                              {{#if (eq this.status 'Rejected')}}bg-red-100 text-red-600{{/if}}
                              {{#if (eq this.status 'Accepted')}}bg-green-100 text-green-600{{/if}}">
                              {{this.status}}
                            </span>
            </td>

            <td class="p-4">
              {{#if this.cv.file_url}}
                <a href="{{this.cv.file_url}}" target="_blank" class="text-primary hover:underline text-sm flex items-center gap-1">
                  <span class="material-symbols-outlined text-base">picture_as_pdf</span> View CV
                </a>
              {{else}}
                <span class="text-gray-400 text-sm">No CV</span>
              {{/if}}
            </td>

            <td class="p-4 text-right">
              <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                <button onclick="updateStatus({{this.application_id}}, 'Interview')"
                        class="p-2 rounded bg-blue-50 text-blue-600 hover:bg-blue-100" title="Interview">
                  <span class="material-symbols-outlined text-lg">calendar_month</span>
                </button>

                <button onclick="updateStatus({{this.application_id}}, 'Rejected')"
                        class="p-2 rounded bg-red-50 text-red-600 hover:bg-red-100" title="Reject">
                  <span class="material-symbols-outlined text-lg">close</span>
                </button>

                <button onclick="updateStatus({{this.application_id}}, 'Accepted')"
                        class="p-2 rounded bg-green-50 text-green-600 hover:bg-green-100" title="Accept">
                  <span class="material-symbols-outlined text-lg">check</span>
                </button>
              </div>
            </td>
          </tr>
        {{/each}}

        {{#unless applications}}
          <tr>
            <td colspan="5" class="p-8 text-center text-gray-500">
              No applications yet.
            </td>
          </tr>
        {{/unless}}
        </tbody>
      </table>
    </div>
  </main>
</div>

<script>
  async function updateStatus(appId, newStatus) {
    if(!confirm('Change status to ' + newStatus + '?')) return;

    try {
      const response = await fetch(`/recruiter/applications/${appId}/status`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ status: newStatus })
      });

      if (response.ok) {
        alert('Status updated!');
        location.reload(); // Load lại trang để thấy status mới
      } else {
        alert('Failed to update status');
      }
    } catch (error) {
      console.error(error);
      alert('Error occurred');
    }
  }
</script>

</body>
</html>