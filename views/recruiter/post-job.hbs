<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Đăng tin tuyển dụng | TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> recruiter_sidebar activePage='post-job'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm">
    <h1 class="text-xl font-bold text-slate-800">Tạo tin tuyển dụng mới</h1>
  </header>

  <div class="flex-1 overflow-y-auto p-8">
    <form id="postJobForm" class="max-w-4xl mx-auto space-y-6">
      <div class="flex justify-end gap-2">
        <button type="button" onclick="openAIPrompt()" class="text-xs font-bold text-white bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-600 hover:to-indigo-700 px-4 py-2 rounded-full shadow-md flex items-center gap-1 transition-all">
          <span class="material-symbols-outlined text-sm">auto_awesome</span> Tạo nhanh bằng AI
        </button>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-indigo-500">article</span> Thông tin chung
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-slate-700 mb-1">Tiêu đề công việc <span class="text-red-500">*</span></label>
            <input type="text" name="title" id="title" required placeholder="VD: Senior Frontend Developer" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Địa điểm <span class="text-red-500">*</span></label>
            <input type="text" name="location" id="location" required placeholder="VD: Hồ Chí Minh" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition">
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Lương tối thiểu (VNĐ) <span class="text-red-500">*</span></label>
            <input type="number" name="salary_min" id="salary_min" step="1" min="0" required placeholder="VD: 10000000" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Lương tối đa (VNĐ) <span class="text-red-500">*</span></label>
            <input type="number" name="salary_max" id="salary_max" step="1" min="0" required placeholder="VD: 30000000" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition">
          </div>

          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-slate-700 mb-1">Kỹ năng yêu cầu <span class="text-red-500">*</span></label>
            <input type="text" id="skillsInput" required placeholder="VD: ReactJS, NodeJS, MySQL" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition">
            <p class="text-xs text-slate-500 mt-1">Phân cách bằng dấu phẩy.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Hạn nộp <span class="text-red-500">*</span></label>
            <input type="date" name="deadline" id="deadline" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition">
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Loại hình</label>
            <select name="job_type" class="w-full px-4 py-2 border border-slate-300 rounded-lg bg-white">
              <option value="Full-time">Toàn thời gian (Full-time)</option>
              <option value="Part-time">Bán thời gian (Part-time)</option>
              <option value="Freelance">Làm tự do (Freelance)</option>
              <option value="Contract">Hợp đồng (Contract)</option>
              <option value="Internship">Thực tập (Internship)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-indigo-500">description</span> Chi tiết
        </h2>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Mô tả công việc <span class="text-red-500">*</span></label>
            <textarea name="description" id="description" rows="4" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 transition"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Yêu cầu <span class="text-red-500">*</span></label>
            <textarea name="requirements" id="requirements" rows="4" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 transition"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Quyền lợi</label>
            <textarea name="benefits" id="benefits" rows="4" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 transition"></textarea>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pb-8">
        <button type="submit" class="px-6 py-2 bg-indigo-600 text-white font-bold rounded-lg hover:bg-indigo-700 shadow-lg transition flex items-center gap-2">
          <span class="material-symbols-outlined text-sm">send</span> Đăng tin
        </button>
      </div>
    </form>
  </div>
</main>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
  function validateFullForm() {
    const requiredIds = ['title', 'location', 'salary_min', 'salary_max', 'skillsInput', 'deadline', 'description', 'requirements'];
    let isValid = true;

    requiredIds.forEach(id => {
      const el = document.getElementById(id);
      if(!el.value.trim()) {
        el.classList.add('border-red-500', 'bg-red-50');
        isValid = false;
      } else {
        el.classList.remove('border-red-500', 'bg-red-50');
      }
    });

    if (!isValid) {
      showError("Vui lòng điền đầy đủ tất cả các trường bắt buộc!");
      return false;
    }

    const min = parseFloat(document.getElementById('salary_min').value);
    const max = parseFloat(document.getElementById('salary_max').value);
    if (min >= max) {
      showError("Lương tối đa phải lớn hơn lương tối thiểu!");
      document.getElementById('salary_max').focus();
      return false;
    }

    const deadline = new Date(document.getElementById('deadline').value);
    const today = new Date();
    today.setHours(0,0,0,0);
    if (deadline < today) {
      showError("Hạn nộp hồ sơ phải là ngày trong tương lai!");
      document.getElementById('deadline').focus();
      return false;
    }

    return true;
  }

  function showError(msg) {
    Toastify({ text: "⚠️ " + msg, duration: 3000, gravity: "top", position: "center", style: { background: "#ef4444" } }).showToast();
  }

  async function openAIPrompt() {
    const { value: prompt } = await Swal.fire({
      title: 'AI Hỗ trợ tạo tin 🤖',
      input: 'textarea',
      inputLabel: 'Mô tả ngắn gọn vị trí cần tuyển',
      inputPlaceholder: 'VD: Cần tuyển React Dev, lương khoảng 20tr...',
      showCancelButton: true,
      confirmButtonText: 'Tạo ngay',
      showLoaderOnConfirm: true,
      preConfirm: async (prompt) => {
        if(!prompt) return Swal.showValidationMessage('Vui lòng nhập mô tả');
        try {
          const res = await axios.post('/recruiter/jobs/generate-ai', { prompt });
          if(!res.data.success) throw new Error(res.data.message);
          return res.data.data;
        } catch(e) { Swal.showValidationMessage(e.message); }
      }
    });

    if (prompt) {
      const data = prompt;
      const form = document.getElementById('postJobForm');
      ['title', 'location', 'description', 'requirements', 'benefits'].forEach(f => {
        if(data[f]) form.elements[f].value = data[f];
      });
      // Hiển thị số nguyên từ AI
      if(data.salary_min) document.getElementById('salary_min').value = Math.floor(data.salary_min);
      if(data.salary_max) document.getElementById('salary_max').value = Math.floor(data.salary_max);

      if(data.skills && Array.isArray(data.skills)) document.getElementById('skillsInput').value = data.skills.join(', ');

      Toastify({ text: "✨ Đã điền nội dung từ AI! Vui lòng kiểm tra lại.", style: { background: "linear-gradient(to right, #8e2de2, #4a00e0)" } }).showToast();
    }
  }

  document.getElementById('postJobForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    if(!validateFullForm()) return;

    const formData = new FormData(e.target);
    const skillsArray = document.getElementById('skillsInput').value.split(',').map(s => s.trim()).filter(s => s);

    const payload = {
      title: formData.get('title'),
      location: formData.get('location'),
      salary_min: parseInt(formData.get('salary_min')), // Gửi số nguyên
      salary_max: parseInt(formData.get('salary_max')), // Gửi số nguyên
      job_type: formData.get('job_type'),
      deadline: formData.get('deadline'),
      description: formData.get('description'),
      requirements: formData.get('requirements'),
      benefits: formData.get('benefits'),
      skills: skillsArray
    };

    try {
      await axios.post('/recruiter/jobs', payload);
      Toastify({ text: "✅ Đăng tin thành công!", style: { background: "#10b981" } }).showToast();
      setTimeout(() => window.location.href = '/recruiter/jobs', 1500);
    } catch (e) {
      showError(e.response?.data?.message || e.message);
    }
  });
</script>
</body>
</html>