<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Post New Job - TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-900">

<div class="flex h-screen overflow-hidden">
  <aside class="w-64 bg-white border-r border-slate-200 flex flex-col shadow-sm z-20">
    <div class="h-16 flex items-center px-6 border-b border-slate-100">
      <span class="material-symbols-outlined text-indigo-600 text-3xl mr-2">rocket_launch</span>
      <span class="text-lg font-bold text-slate-800">Recruiter</span>
    </div>
    <nav class="flex-1 px-4 py-6 space-y-2">
      <a href="/recruiter/dashboard" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 hover:text-indigo-600 rounded-lg transition-colors">
        <span class="material-symbols-outlined">dashboard</span> Dashboard
      </a>
      <a href="/recruiter/my-jobs" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 hover:text-indigo-600 rounded-lg transition-colors">
        <span class="material-symbols-outlined">business_center</span> My Jobs
      </a>
      <a href="/recruiter/post-job" class="flex items-center gap-3 px-4 py-3 bg-indigo-50 text-indigo-600 rounded-lg transition-colors font-medium">
        <span class="material-symbols-outlined">add_circle</span> Post Job
      </a>
    </nav>
    <div class="p-4 border-t border-slate-100">
      <a href="/web/logout" class="text-sm text-red-500 hover:text-red-700">Sign Out</a>
    </div>
  </aside>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm">
      <h1 class="text-xl font-bold text-slate-800">Create New Job Opportunity</h1>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-200">
        <form id="postJobForm" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Job Title</label>
            <input type="text" name="title" required placeholder="e.g. Senior Backend Developer"
                   class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Job Type</label>
              <select name="job_type" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
                <option value="Full-time">Full-time</option>
                <option value="Part-time">Part-time</option>
                <option value="Freelance">Freelance</option>
                <option value="Internship">Internship</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Location</label>
              <input type="text" name="location" placeholder="e.g. Ho Chi Minh City / Remote"
                     class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Min Salary ($)</label>
              <input type="number" name="salary_min" placeholder="1000"
                     class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Max Salary ($)</label>
              <input type="number" name="salary_max" placeholder="2000"
                     class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Required Skills (Comma separated)</label>
            <input type="text" name="skills" placeholder="Java, Spring Boot, MySQL" required
                   class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
            <p class="text-xs text-slate-500 mt-1">Example: Nodejs, React, MongoDB</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Deadline</label>
            <input type="date" name="deadline"
                   class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500">
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Job Description</label>
            <textarea name="description" rows="5" required placeholder="Describe the role..."
                      class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Requirements</label>
            <textarea name="requirements" rows="4" placeholder="List requirements..."
                      class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>

          <div class="pt-4 flex justify-end">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded-lg transition shadow-lg shadow-indigo-200">
              Publish Job
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>
</div>

<script>
  document.getElementById('postJobForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());

    // Xử lý skills: Chuyển string "A, B, C" thành mảng ["A", "B", "C"]
    if (data.skills) {
      data.skills = data.skills.split(',').map(s => s.trim()).filter(s => s !== '');
    }

    // Chuyển lương sang số
    data.salary_min = data.salary_min ? Number(data.salary_min) : null;
    data.salary_max = data.salary_max ? Number(data.salary_max) : null;

    try {
      const response = await fetch('/recruiter/jobs', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        alert('Job Posted Successfully!');
        window.location.href = '/recruiter/dashboard';
      } else {
        const error = await response.json();
        alert('Error: ' + (error.message || 'Failed to post job'));
      }
    } catch (err) {
      console.error(err);
      alert('Something went wrong.');
    }
  });
</script>

</body>
</html>