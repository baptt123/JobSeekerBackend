<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bảng điều khiển - TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
    rel="stylesheet"
  />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900">
<div class="flex h-screen overflow-hidden">
  {{> recruiter_sidebar activePage='dashboard'}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm z-10">
      <div>
        <h1 class="text-xl font-bold text-slate-800">Tổng quan công ty</h1>
        <p class="text-xs text-slate-500">Chào mừng trở lại, {{company}}</p>
      </div>
      <div class="flex gap-4">
        <a href="/recruiter/post-job" class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition shadow-sm shadow-indigo-200">
          <span class="material-symbols-outlined text-lg">add</span>
          Đăng tin mới
        </a>
      </div>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
          <div class="flex justify-between items-center mb-4">
            <div class="p-3 bg-blue-50 text-blue-600 rounded-lg">
              <span class="material-symbols-outlined">work</span>
            </div>
            <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full">Thời gian thực</span>
          </div>
          <p class="text-slate-500 text-sm font-medium">Tin đang hoạt động</p>
          <h3 class="text-3xl font-bold text-slate-800">{{stats.activeJobs}}</h3>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
          <div class="flex justify-between items-center mb-4">
            <div class="p-3 bg-purple-50 text-purple-600 rounded-lg">
              <span class="material-symbols-outlined">description</span>
            </div>
            <span class="text-xs font-medium text-slate-500">Tất cả</span>
          </div>
          <p class="text-slate-500 text-sm font-medium">Tổng đơn ứng tuyển</p>
          <h3 class="text-3xl font-bold text-slate-800">{{stats.totalApplications}}</h3>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
          <div class="flex justify-between items-center mb-4">
            <div class="p-3 bg-orange-50 text-orange-600 rounded-lg">
              <span class="material-symbols-outlined">post_add</span>
            </div>
          </div>
          <p class="text-slate-500 text-sm font-medium">Tổng tin đã đăng</p>
          <h3 class="text-3xl font-bold text-slate-800">{{stats.totalJobs}}</h3>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col">
          <h3 class="text-lg font-bold text-slate-800 mb-6">Xu hướng ứng tuyển (6 tháng gần đây)</h3>
          <div class="flex-1 flex items-center justify-center relative min-h-[300px]">
            <canvas id="applicationChart"></canvas>
          </div>
        </div>

        <div class="lg:col-span-1 bg-white p-6 rounded-xl shadow-sm border border-slate-100">
          <h3 class="text-lg font-bold text-slate-800 mb-6">Thao tác nhanh</h3>
          <div class="space-y-4">
            <a href="/recruiter/post-job" class="block p-4 border border-slate-100 rounded-lg hover:bg-slate-50 transition">
              <div class="font-semibold text-slate-700">Đăng tuyển dụng</div>
              <div class="text-xs text-slate-500">Tạo cơ hội việc làm mới</div>
            </a>
            <a href="/recruiter/jobs" class="block p-4 border border-slate-100 rounded-lg hover:bg-slate-50 transition">
              <div class="font-semibold text-slate-700">Quản lý việc làm</div>
              <div class="text-xs text-slate-500">Xem và chỉnh sửa danh sách</div>
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  // Lấy dữ liệu từ Controller (đã JSON.stringify)
  const rawData = {{{chartData}}};
  console.log("Chart Data:", rawData);

  const ctx = document.getElementById('applicationChart').getContext('2d');

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: rawData.labels, // ['Tháng 7', 'Tháng 8'...]
      datasets: [{
        label: 'Số lượng ứng tuyển',
        data: rawData.data,   // [10, 15...]
        backgroundColor: '#6366f1',
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: { beginAtZero: true }
      }
    }
  });
</script>
</body>
</html>