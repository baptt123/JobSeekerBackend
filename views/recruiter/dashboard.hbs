<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script>
      tailwind.config = {
        theme: { extend: { colors: { "primary": "#6b26d9" } } }
      }
    </script>
</head>
<body class="font-display bg-gray-50">
<div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
    <div class="flex flex-row min-h-screen">

        {{> recruiter_sidebar activePage='dashboard'}}

        <main class="flex-1">
             <header class="flex items-center justify-between border-b px-10 py-4 bg-white">
                <h1 class="text-xl font-bold text-gray-800">Recruiter Portal - {{company.name}}</h1>
             </header>

            <div class="p-10">
                <div class="flex flex-wrap justify-between gap-3 mb-6">
                    <p class="text-gray-900 text-4xl font-black">{{company.name}} Overview</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">

                    <div class="flex flex-col gap-4 rounded-xl p-6 bg-white shadow-sm border border-gray-200">
                        <div class="flex items-center justify-between">
                            <p class="text-gray-700 text-base font-medium">Active Jobs</p>
                            <span class="material-symbols-outlined text-primary">business_center</span>
                        </div>
                        <p class="text-gray-900 text-3xl font-bold">{{stats.activeJobs}}</p>
                    </div>

                    <div class="flex flex-col gap-4 rounded-xl p-6 bg-white shadow-sm border border-gray-200">
                        <div class="flex items-center justify-between">
                            <p class="text-gray-700 text-base font-medium">Total Applications</p>
                            <span class="material-symbols-outlined text-primary">description</span>
                        </div>
                        <p class="text-gray-900 text-3xl font-bold">{{stats.totalApplications}}</p>
                    </div>

                    <div class="flex flex-col gap-4 rounded-xl p-6 bg-primary/10 shadow-sm border border-primary/20 cursor-pointer hover:bg-primary/20 transition">
                         <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary text-3xl">add_circle</span>
                            <p class="text-primary text-xl font-bold">Post New Job</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
</body>
</html>