<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tin nhắn | TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> recruiter_sidebar activePage='chat'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden bg-white">
  <div class="flex h-full">
    <div class="w-80 border-r border-slate-200 flex flex-col bg-slate-50">
      <div class="p-4 border-b border-slate-200 font-bold text-lg text-slate-800">
        Tin nhắn
      </div>
      <div class="flex-1 overflow-y-auto" id="conversationList">
        <div class="p-4 text-center text-slate-400 text-sm">Đang tải danh sách...</div>
      </div>
    </div>

    <div class="flex-1 flex flex-col">
      <div class="h-16 border-b border-slate-200 flex items-center px-6 justify-between bg-white">
        <div class="flex items-center gap-3">
          <div id="headerAvatar" class="w-10 h-10 rounded-full bg-slate-200"></div>
          <div>
            <h3 id="headerName" class="font-bold text-slate-800">Chọn cuộc hội thoại</h3>
          </div>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto p-6 bg-slate-50 space-y-4" id="messageContainer"></div>

      <div class="p-4 border-t border-slate-200 bg-white">
        <form id="chatForm" class="flex gap-2">
          <input type="text" id="msgInput" placeholder="Nhập tin nhắn..." disabled
                 class="flex-1 px-4 py-2 border border-slate-300 rounded-full focus:ring-2 focus:ring-indigo-500 outline-none">
          <button type="submit" id="sendBtn" disabled
                  class="bg-indigo-600 hover:bg-indigo-700 text-white w-10 h-10 rounded-full flex items-center justify-center disabled:opacity-50">
            <span class="material-symbols-outlined text-[20px]">send</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</main>

<script>
  let currentReceiverId = null;
  let socket;
  const myUserId = {{user.user_id}};

  // 1. Kết nối Socket
  socket = io('/', { query: { userId: myUserId } });

  socket.on('receive_message', (data) => {
    // Chỉ hiện tin nhắn nếu đang mở chat với người gửi
    if (data.senderId == currentReceiverId) {
      appendMessage(data.content, 'left');
      scrollToBottom();
    }
  });

  // 2. Load danh sách chat
  async function loadConversations() {
    try {
      // Cần có API /recruiter/conversations trả về list user
      const res = await axios.get('/recruiter/conversations');
      const list = document.getElementById('conversationList');
      list.innerHTML = '';

      res.data.forEach(user => {
        const isActive = user.id === currentReceiverId ? 'bg-indigo-50 border-r-4 border-indigo-500' : 'hover:bg-slate-100';
        list.innerHTML += `
                    <div onclick="selectUser(${user.id}, '${user.name}', '${user.avatar}')"
                         class="p-4 cursor-pointer border-b border-slate-100 transition flex items-center gap-3 ${isActive}">
                        <img src="${user.avatar}" class="w-10 h-10 rounded-full object-cover">
                        <div>
                            <p class="font-bold text-slate-800 text-sm">${user.name}</p>
                            <p class="text-xs text-slate-500 truncate w-40">Bấm để chat...</p>
                        </div>
                    </div>
                `;
      });
    } catch(e) {
      console.error("Cần tạo API conversations", e);
    }
  }
  // loadConversations(); // Uncomment khi đã có API

  // 3. Chọn User
  window.selectUser = async (id, name, avatar) => {
    currentReceiverId = id;
    document.getElementById('headerName').innerText = name;
    document.getElementById('headerAvatar').innerHTML = `<img src="${avatar}" class="w-full h-full rounded-full object-cover">`;
    document.getElementById('msgInput').disabled = false;
    document.getElementById('sendBtn').disabled = false;

    // Load lịch sử chat
    const res = await axios.get(`/recruiter/messages/${id}`);
    const container = document.getElementById('messageContainer');
    container.innerHTML = '';
    res.data.forEach(msg => {
      const side = msg.sender_id === myUserId ? 'right' : 'left';
      appendMessage(msg.content, side);
    });
    scrollToBottom();
  }

  // 4. Gửi tin
  document.getElementById('chatForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('msgInput');
    const content = input.value.trim();
    if(!content || !currentReceiverId) return;

    appendMessage(content, 'right');
    scrollToBottom();
    input.value = '';

    try {
      await axios.post('/recruiter/send-message', {
        receiverId: currentReceiverId,
        content: content
      });
    } catch(e) { console.error(e); }
  });

  function appendMessage(text, side) {
    const container = document.getElementById('messageContainer');
    const align = side === 'right' ? 'justify-end' : 'justify-start';
    const bg = side === 'right' ? 'bg-indigo-600 text-white rounded-br-none' : 'bg-white border border-slate-200 text-slate-800 rounded-bl-none';

    container.innerHTML += `
            <div class="flex ${align}">
                <div class="max-w-[70%] px-4 py-2 rounded-2xl shadow-sm text-sm ${bg}">
                    ${text}
                </div>
            </div>
        `;
  }
  function scrollToBottom() {
    const c = document.getElementById('messageContainer');
    c.scrollTop = c.scrollHeight;
  }
</script>
</body>
</html>