<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Jobs - Recruiter</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-slate-50 text-slate-900">

<div class="flex h-screen overflow-hidden">
  <aside class="w-64 bg-white border-r border-slate-200 flex flex-col shadow-sm z-20">
    <div class="h-16 flex items-center px-6 border-b border-slate-100">
      <span class="material-symbols-outlined text-indigo-600 text-3xl mr-2">rocket_launch</span>
      <span class="text-lg font-bold text-slate-800">Recruiter</span>
    </div>
    <nav class="flex-1 px-4 py-6 space-y-2">
      <a href="/recruiter/dashboard" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 hover:text-indigo-600 rounded-lg transition-colors">
        <span class="material-symbols-outlined">dashboard</span> Dashboard
      </a>
      <a href="/recruiter/my-jobs" class="flex items-center gap-3 px-4 py-3 bg-indigo-50 text-indigo-600 rounded-lg transition-colors font-medium">
        <span class="material-symbols-outlined">business_center</span> My Jobs
      </a>
      <a href="/recruiter/post-job" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 hover:text-indigo-600 rounded-lg transition-colors">
        <span class="material-symbols-outlined">add_circle</span> Post Job
      </a>
    </nav>
    <div class="p-4 border-t border-slate-100">
      <a href="/web/logout" class="text-sm text-red-500 hover:text-red-700 font-medium">Sign Out</a>
    </div>
  </aside>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm">
      <h1 class="text-xl font-bold text-slate-800">Job Listings</h1>
      <a href="/recruiter/post-job" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">add</span> Post New Job
      </a>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      {{#unless jobs}}
        <div class="text-center py-20 bg-white rounded-xl border border-dashed border-slate-300">
          <span class="material-symbols-outlined text-6xl text-slate-300 mb-4">work_off</span>
          <p class="text-lg text-slate-500">You haven't posted any jobs yet.</p>
          <a href="/recruiter/post-job" class="text-indigo-600 font-medium mt-2 inline-block">Post your first job</a>
        </div>
      {{else}}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="p-4 text-sm font-semibold text-slate-600">Job Title</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Type & Location</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Salary Range</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Applications</th>
              <th class="p-4 text-sm font-semibold text-slate-600 text-right">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
            {{#each jobs}}
              <tr class="hover:bg-slate-50 transition">
                <td class="p-4">
                  <p class="font-bold text-slate-800 text-base">{{this.title}}</p>
                  <p class="text-xs text-slate-400">Posted: {{this.created_at}}</p>
                </td>
                <td class="p-4">
                  <p class="text-sm text-slate-700">{{this.job_type}}</p>
                  <p class="text-xs text-slate-500">{{this.location}}</p>
                </td>
                <td class="p-4 text-sm text-slate-600">
                  ${{this.salary_min}} - ${{this.salary_max}}
                </td>
                <td class="p-4">
                  <a href="/recruiter/jobs/{{this.job_id}}/applications" class="inline-flex items-center gap-1 px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold hover:bg-indigo-200 transition">
                    <span class="material-symbols-outlined text-sm">group</span>
                    {{this.applications.length}} Applicants
                  </a>
                </td>
                <td class="p-4 text-right">
                  <a href="/recruiter/jobs/{{this.job_id}}" class="text-slate-400 hover:text-indigo-600 mr-2" title="View Detail"><span class="material-symbols-outlined">visibility</span></a>
                  <button class="text-slate-400 hover:text-red-600" title="Close Job"><span class="material-symbols-outlined">archive</span></button>
                </td>
              </tr>
            {{/each}}
            </tbody>
          </table>
        </div>
      {{/unless}}
    </main>
  </div>
</div>
</body>
</html>