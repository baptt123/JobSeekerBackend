<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Việc làm của tôi - TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900">
<div class="flex h-screen overflow-hidden">
  {{> recruiter_sidebar activePage='my-jobs'}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm">
      <h1 class="text-xl font-bold text-slate-800">Danh sách việc làm</h1>
      <a href="/recruiter/post-job" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">add</span> Đăng tin mới
      </a>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      {{#unless jobs}}
        <div class="text-center py-20 bg-white rounded-xl border border-dashed border-slate-300">
          <span class="material-symbols-outlined text-6xl text-slate-300 mb-4">work_off</span>
          <p class="text-lg text-slate-500">Bạn chưa đăng tin tuyển dụng nào.</p>
          <a href="/recruiter/post-job" class="text-indigo-600 font-medium mt-2 inline-block">Đăng tin đầu tiên</a>
        </div>
      {{else}}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="p-4 text-sm font-semibold text-slate-600">Tiêu đề & Kỹ năng</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Thông tin</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Lương</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Ứng viên</th>
              <th class="p-4 text-sm font-semibold text-slate-600 text-right">Hành động</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
            {{#each jobs}}
              <tr class="hover:bg-slate-50 transition">
                <td class="p-4">
                  <p class="font-bold text-slate-800 text-base">{{this.title}}</p>
                  <p class="text-xs text-indigo-600 mt-1 font-medium">
                    {{#if this.skillNames}}Kỹ năng: {{this.skillNames}}{{else}}Không có thẻ kỹ năng{{/if}}
                  </p>
                </td>
                <td class="p-4">
                  <span class="px-2 py-1 bg-slate-100 rounded text-xs font-semibold text-slate-600">{{this.job_type}}</span>
                  <p class="text-xs text-slate-500 mt-1">{{this.location}}</p>
                </td>
                <td class="p-4 text-sm text-slate-600 font-medium">
                  {{formatCurrency this.salary_min}} - {{formatCurrency this.salary_max}}
                </td>
                <td class="p-4">
                  <a href="/recruiter/jobs/{{this.job_id}}" class="inline-flex items-center gap-1 px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full text-xs font-bold hover:bg-indigo-100 transition">
                    <span class="material-symbols-outlined text-sm">group</span> Xem ứng viên
                  </a>
                </td>
                <td class="p-4 text-right">
                  <a href="/recruiter/jobs/{{this.job_id}}" class="text-slate-400 hover:text-indigo-600 mr-2" title="Xem chi tiết">
                    <span class="material-symbols-outlined">visibility</span>
                  </a>
                </td>
              </tr>
            {{/each}}
            </tbody>
          </table>
        </div>
      {{/unless}}
    </main>
  </div>
</div>
</body>
</html>