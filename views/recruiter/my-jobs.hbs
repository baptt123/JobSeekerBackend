<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Việc làm của tôi - TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <script>tailwind.config = { theme: { extend: { colors: { primary: '#6b26d9' } } } }</script>
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900">
<div class="flex h-screen overflow-hidden">

  {{> recruiter_sidebar activePage='jobs'}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm">
      <h1 class="text-xl font-bold text-slate-800">Danh sách việc làm</h1>
      <a href="/recruiter/jobs/create" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">add</span> Đăng tin mới
      </a>
    </header>

    <main class="flex-1 overflow-y-auto p-8 custom-scroll">
      {{#unless jobs}}
        <div class="text-center py-20 bg-white rounded-xl border border-dashed border-slate-300">
          <span class="material-symbols-outlined text-6xl text-slate-300 mb-4">work_off</span>
          <p class="text-lg text-slate-500">Bạn chưa đăng tin tuyển dụng nào.</p>
          <a href="/recruiter/jobs/create" class="text-indigo-600 font-medium mt-2 inline-block">Đăng tin đầu tiên</a>
        </div>
      {{else}}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
          <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="p-4 text-sm font-semibold text-slate-600">Tiêu đề & Kỹ năng</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Thông tin</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Lương</th>
              <th class="p-4 text-sm font-semibold text-slate-600">Ứng viên</th>
              <th class="p-4 text-sm font-semibold text-slate-600 text-right">Hành động</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
            {{#each jobs}}
              <tr class="hover:bg-slate-50 transition">
                <td class="p-4 align-top">
                  <p class="font-bold text-slate-800 text-base">{{this.title}}</p>
                  <div class="mt-2 flex flex-wrap gap-1">
                    {{#if this.jobSkills}}
                      {{#each this.jobSkills}}
                        <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-[11px] font-medium rounded border border-slate-200">
                          {{this.skill.skill_name}}
                        </span>
                      {{/each}}
                    {{else}}
                      <span class="text-xs text-slate-400 italic">Chưa có kỹ năng</span>
                    {{/if}}
                  </div>
                </td>

                <td class="p-4 align-top">
                  <span class="px-2 py-1 bg-blue-50 text-blue-700 rounded text-xs font-semibold border border-blue-100">{{this.job_type}}</span>
                  <div class="mt-2 space-y-1">
                    <div class="flex items-center gap-1 text-slate-500">
                      <span class="material-symbols-outlined text-[14px]">location_on</span>
                      <p class="text-xs">{{this.location}}</p>
                    </div>
                    <div class="flex items-center gap-1 text-slate-500">
                      <span class="material-symbols-outlined text-[14px]">event_busy</span>
                      <p class="text-xs">Hạn nộp: <span class="font-medium text-slate-700">{{formatDate this.deadline}}</span></p>
                    </div>
                  </div>
                </td>

                <td class="p-4 align-top">
                  <div class="flex items-center gap-1">
                    <span class="text-indigo-600 font-bold text-sm">{{formatCurrency this.salary_min}}</span>
                    <span class="text-slate-400 mx-1">-</span>
                    <span class="text-indigo-600 font-bold text-sm">{{formatCurrency this.salary_max}}</span>
                    <span class="text-xs text-slate-500 font-medium ml-1">VNĐ</span>
                  </div>
                </td>

                <td class="p-4 align-top">
                  <a href="/recruiter/jobs/{{this.job_id}}" class="inline-flex items-center gap-1 px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full text-xs font-bold hover:bg-indigo-100 transition border border-indigo-100">
                    <span class="material-symbols-outlined text-sm">group</span> Xem ứng viên
                  </a>
                </td>

                <td class="p-4 align-top text-right">
                  <a href="/recruiter/jobs/{{this.job_id}}" class="text-slate-400 hover:text-indigo-600 p-2 rounded-full hover:bg-indigo-50 transition inline-block" title="Xem chi tiết">
                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                  </a>
                </td>
              </tr>
            {{/each}}
            </tbody>
          </table>
        </div>
      {{/unless}}
    </main>
  </div>
</div>
</body>
</html>