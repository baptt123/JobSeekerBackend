<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hồ sơ công ty | TechConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            primary: '#6366f1',
            secondary: '#a855f7'
          }
        }
      }
    }
  </script>
  <style>
    .glass-effect {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
    }
    .gradient-bg {
      background: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
    }
    /* Tùy chỉnh thanh cuộn */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen overflow-hidden flex">

{{> recruiter_sidebar activePage='profile'}}

<main class="flex-1 overflow-y-auto relative h-full">
  <div class="h-64 gradient-bg w-full absolute top-0 left-0 z-0">
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="absolute top-10 right-10 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
    <div class="absolute bottom-5 left-20 w-40 h-40 bg-white/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 px-8 pt-48 pb-24 max-w-5xl mx-auto">

    <form id="companyForm" class="glass-effect rounded-3xl shadow-xl border border-white/50 p-8 pt-0 animate-fade-in-up">

      <div class="flex flex-col md:flex-row items-center md:items-end gap-6 -mt-16 mb-8 px-4">
        <div class="relative group">
          <div class="w-32 h-32 rounded-2xl bg-white p-1 shadow-lg ring-4 ring-white/50 overflow-hidden relative">
            <img id="logoPreview"
                 src="{{company.logo_url}}"
                 data-default="https://ui-avatars.com/api/?name={{company.name}}&background=6366f1&color=fff&size=128"
            class="w-full h-full object-contain rounded-xl bg-slate-100"
            alt="Company Logo"
            onerror="this.onerror=null; this.src=this.dataset.default;">

            <label for="logoInput" class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer rounded-xl z-10">
              <span class="material-symbols-outlined text-white text-3xl mb-1">photo_camera</span>
              <span class="text-white text-xs font-medium">Đổi Logo</span>
            </label>
            <input type="file" id="logoInput" accept="image/*" class="hidden" onchange="previewLogo(this)">
          </div>
        </div>

        <div class="flex-1 text-center md:text-left mb-2">
          <h1 class="text-3xl font-bold text-slate-800">{{company.name}}</h1>
          <p class="text-slate-500 font-medium flex items-center justify-center md:justify-start gap-1">
            <span class="material-symbols-outlined text-lg text-blue-500">verified</span>
            Công ty đã xác minh
          </p>
        </div>

        <div class="flex gap-3">
          <button type="button" onclick="window.location.reload()" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold hover:bg-slate-50 transition">
            Hủy
          </button>
          <button type="submit" id="btnSave" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold shadow-lg shadow-indigo-200 hover:shadow-indigo-300 transform hover:-translate-y-0.5 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-xl">save</span>
            Lưu thay đổi
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 px-4">

        <div class="space-y-6">
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2 ml-1">Tên công ty</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-3.5 text-slate-400">domain</span>
              <input type="text" name="name" value="{{company.name}}" required
                     class="w-full pl-12 pr-4 py-3 bg-slate-50 border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none font-medium text-slate-700 placeholder-slate-400">
            </div>
          </div>

          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2 ml-1">Website</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-3.5 text-slate-400">language</span>
              <input type="url" name="website" value="{{company.website}}" placeholder="https://example.com"
                     class="w-full pl-12 pr-4 py-3 bg-slate-50 border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none font-medium text-slate-700 placeholder-slate-400">
            </div>
          </div>

          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2 ml-1">Địa chỉ trụ sở</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-4 top-3.5 text-slate-400">location_on</span>
              <textarea name="address" rows="3" placeholder="VD: 123 Đường ABC, Quận 1, TP.HCM"
                        class="w-full pl-12 pr-4 py-3 bg-slate-50 border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none font-medium text-slate-700 placeholder-slate-400 resize-none">{{company.address}}</textarea>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2 ml-1">Giới thiệu công ty</label>
            <div class="relative">
              <textarea name="description" rows="10" placeholder="Giới thiệu về sứ mệnh, văn hóa và giá trị của công ty bạn..."
                        class="w-full p-4 bg-slate-50 border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none font-medium text-slate-700 placeholder-slate-400 resize-none">{{company.description}}</textarea>
              <span class="material-symbols-outlined absolute right-4 top-4 text-slate-300">format_quote</span>
            </div>
          </div>
        </div>

      </div>
    </form>

    <div class="mt-8 text-center text-slate-400 text-sm">
      <p>&copy; 2025 TechConnect. Bảo lưu mọi quyền.</p>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  // 0. HÀM LẤY COOKIE TOKEN (Để xác thực khi upload)
  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
  }

  // 1. INIT LOGIC: Kiểm tra ảnh khi load trang
  document.addEventListener("DOMContentLoaded", () => {
    const img = document.getElementById('logoPreview');
    const currentSrc = img.getAttribute('src');
    const defaultSrc = img.dataset.default;

    // Nếu src rỗng, hoặc chứa text rác "Tạm thời", hoặc không phải link http
    // thì thay thế ngay lập tức bằng ảnh mặc định
    if (!currentSrc || currentSrc.includes('Tạm thời') || !currentSrc.startsWith('http')) {
      img.src = defaultSrc;
    }
  });

  // 2. PREVIEW LOGO TRƯỚC KHI UPLOAD
  function previewLogo(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('logoPreview').src = e.target.result;
      }
      reader.readAsDataURL(input.files[0]);
    }
  }

  // 3. XỬ LÝ SUBMIT FORM
  document.getElementById('companyForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const btn = document.getElementById('btnSave');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-xl">sync</span> Đang lưu...';
    btn.disabled = true;
    btn.classList.add('opacity-75', 'cursor-not-allowed');

    try {
      // B1: Upload Logo nếu có file mới
      const fileInput = document.getElementById('logoInput');
      // Lấy URL từ thẻ img (đã được xử lý ở bước Init)
      let logoUrl = document.getElementById('logoPreview').src;

      if (fileInput.files.length > 0) {
        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        // Lấy token từ cookie
        const token = getCookie('access_token');

        // [QUAN TRỌNG] Gọi endpoint upload với Header Authorization
        const uploadRes = await axios.post('/cloudinary-custom/upload-file', formData, {
          headers: {
            'Content-Type': 'multipart/form-data',
            'Authorization': `Bearer ${token}`
          }
        });
        logoUrl = uploadRes.data.url;
      }

      // B2: Chuẩn bị dữ liệu cập nhật
      const formEl = new FormData(this);
      const payload = {
        name: formEl.get('name'),
        website: formEl.get('website'),
        address: formEl.get('address'),
        description: formEl.get('description'),
        logo_url: logoUrl
      };

      // B3: Gửi request cập nhật profile
      const response = await fetch('/recruiter/company-profile', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        Toastify({
          text: "🎉 Cập nhật hồ sơ thành công!",
          duration: 3000,
          gravity: "top",
          position: "right",
          style: {
            background: "linear-gradient(to right, #00b09b, #96c93d)",
            borderRadius: "10px",
            boxShadow: "0 4px 6px rgba(0,0,0,0.1)"
          },
        }).showToast();
      } else {
        const errData = await response.json();
        throw new Error(errData.message || 'Cập nhật thất bại');
      }

    } catch (error) {
      console.error(error);
      const msg = error.response?.data?.message || error.message || "Lỗi khi lưu hồ sơ";
      Toastify({
        text: `❌ ${msg}`,
        duration: 3000,
        gravity: "top",
        position: "right",
        style: { background: "#ef4444", borderRadius: "10px" }
      }).showToast();
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
      btn.classList.remove('opacity-75', 'cursor-not-allowed');
    }
  });
</script>
</body>
</html>