<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>RisApps - Buat Departemen</title>
    <script src='https://cdn.tailwindcss.com'></script>
    <script src='https://unpkg.com/lucide-dev'></script>

    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc; /* Màu nền xám nhạt */
      }
      /* Tùy chỉnh nhỏ cho radio button */
      input[type='radio']:checked {
        background-color: #2563eb; /* Màu xanh khi được chọn */
        border-color: #2563eb;
      }
    </style>
  </head>
  <body class='bg-gray-50'>

    <div class='flex h-screen'>
      <aside class='w-64 bg-white border-r flex flex-col'>
        <div class='p-6'>
          <h1 class='text-3xl font-bold text-blue-600'>RisApps</h1>
        </div>

        <nav class='flex-1 px-4 py-2 space-y-2'>
          <a
            href='#'
            class='flex items-center space-x-3 px-4 py-2 text-gray-700 rounded-lg hover:bg-gray-100'
          >
            <i data-lucide='layout-grid' class='w-5 h-5'></i>
            <span>Dashboard</span>
          </a>
          <a
            href='#'
            class='flex items-center space-x-3 px-4 py-2 text-blue-600 bg-blue-50 font-semibold rounded-lg'
          >
            <i data-lucide='users' class='w-5 h-5'></i>
            <span>Departemen</span>
          </a>
          <a
            href='#'
            class='flex items-center space-x-3 px-4 py-2 text-gray-700 rounded-lg hover:bg-gray-100'
          >
            <i data-lucide='clipboard-list' class='w-5 h-5'></i>
            <span>List Kandidat</span>
          </a>
          <a
            href='#'
            class='flex items-center space-x-3 px-4 py-2 text-gray-700 rounded-lg hover:bg-gray-100'
          >
            <i data-lucide='calendar-days' class='w-5 h-5'></i>
            <span>Penjadwalan</span>
          </a>

          <div>
            <button
              class='w-full flex justify-between items-center space-x-3 px-4 py-2 text-gray-700 rounded-lg hover:bg-gray-100'
            >
              <div class='flex items-center space-x-3'>
                <i data-lucide='message-square' class='w-5 h-5'></i>
                <span>Pesan</span>
              </div>
              <i data-lucide='chevron-down' class='w-4 h-4'></i>
            </button>
          </div>
        </nav>

        <div class='p-4 border-t'>
          <div
            class='flex items-center space-x-3 p-3 rounded-lg hover:bg-gray-100 cursor-pointer'
          >
            <div class='relative'>
              <img
                src='https://placehold.co/40x40/d1d5db/374151?text=M'
                alt='Maria'
                class='w-10 h-10 rounded-full'
              />
              <span
                class='absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-white rounded-full'
              ></span>
            </div>
            <div>
              <div class='font-semibold'>Maria</div>
              <div class='text-sm text-gray-500'>Live Chat</div>
            </div>
          </div>
          <a
            href='#'
            class='flex items-center space-x-3 px-3 py-3 text-gray-700 rounded-lg hover:bg-gray-100 mt-2'
          >
            <i data-lucide='log-out' class='w-5 h-5 text-red-500'></i>
            <span>Logout</span>
          </a>
        </div>
      </aside>

      <main class='flex-1 overflow-y-auto'>

        <header class='bg-white border-b sticky top-0 z-10'>
          <div class='flex justify-between items-center px-8 py-5'>
            <div>
              <h2 class='text-2xl font-semibold'>Selamat Datang,
                {{tenNguoiDung}}</h2>
              <p class='text-gray-500'>Semoga harimu cerah</p>
            </div>
            <div class='flex items-center space-x-6'>
              <button class='text-gray-500 hover:text-gray-700'>
                <i data-lucide='search' class='w-6 h-6'></i>
              </button>
              <button class='text-gray-500 hover:text-gray-700 relative'>
                <i data-lucide='bell' class='w-6 h-6'></i>
              </button>
              <button
                class='flex items-center space-x-2 text-gray-700 hover:text-black'
              >
                <img
                  src='https://placehold.co/40x40/3b82f6/ffffff?text=J'
                  alt='Jhon'
                  class='w-10 h-10 rounded-full'
                />
                <span class='font-semibold'>{{tenNguoiDung}}</span>
                <i data-lucide='chevron-down' class='w-4 h-4'></i>
              </button>
            </div>
          </div>
        </header>

        <div class='p-8'>

          <div class='flex justify-between items-center mb-6'>
            <div>
              <h3 class='text-2xl font-semibold'>Departemen</h3>
              <p class='text-sm text-gray-500'>Departemen / Information
                Technology / Buat Lowongan</p>
            </div>
            <button
              class='bg-blue-600 text-white px-5 py-2 rounded-lg flex items-center space-x-2 hover:bg-blue-700'
            >
              <span>Kembali</span>
            </button>
          </div>

          <div class='bg-white p-8 rounded-lg shadow-sm border'>

            <div
              class='border-2 border-dashed border-gray-300 rounded-lg p-12 flex flex-col items-center justify-center text-center'
            >
              <i data-lucide='upload-cloud' class='w-12 h-12 text-gray-400'></i>
              <p class='mt-2 text-gray-700 font-semibold'>Upload Banner</p>
              <p class='text-sm text-gray-500'>Jpg | Png | Pdf | Svg</p>

              <div class='flex space-x-4 mt-6'>
                <button
                  class='bg-blue-600 text-white px-5 py-2.5 rounded-lg flex items-center space-x-2 hover:bg-blue-700'
                >
                  <i data-lucide='upload' class='w-5 h-5'></i>
                  <span>Upload gambar</span>
                </button>
                <button
                  class='bg-white text-gray-700 border border-gray-300 px-5 py-2.5 rounded-lg flex items-center space-x-2 hover:bg-gray-50'
                >
                  <i data-lucide='trash-2' class='w-5 h-5 text-red-500'></i>
                  <span>Hapus Gambar</span>
                </button>
              </div>
            </div>

            <div class='mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6'>

              <div class='space-y-6'>
                <div>
                  <label
                    for='posisi'
                    class='block text-sm font-medium text-gray-700 mb-1'
                  >Posisi</label>
                  <div class='relative'>
                    <input
                      type='text'
                      id='posisi'
                      placeholder='Masukan posisi'
                      class='w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                    />
                    <i
                      data-lucide='chevron-down'
                      class='w-5 h-5 text-gray-400 absolute right-4 top-1/2 -translate-y-1/2'
                    ></i>
                  </div>
                </div>

                <div>
                  <label
                    for='departemen'
                    class='block text-sm font-medium text-gray-700 mb-1'
                  >Departemen</label>
                  <input
                    type='text'
                    id='departemen'
                    placeholder='Masukan Departemen'
                    class='w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                  />
                </div>

                <div>
                  <label
                    for='judul-lowongan-2'
                    class='block text-sm font-medium text-gray-700 mb-1'
                  >Judul lowongan</label>
                  <input
                    type='text'
                    id='judul-lowongan-2'
                    placeholder='Masukan Judul'
                    class='w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                  />
                </div>
              </div>

              <div class='space-y-6'>
                <div>
                  <label
                    for='judul-lowongan'
                    class='block text-sm font-medium text-gray-700 mb-1'
                  >Judul lowongan</label>
                  <input
                    type='text'
                    id='judul-lowongan'
                    placeholder='Masukan Judul'
                    class='w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                  />
                </div>

                <div>
                  <label
                    class='block text-sm font-medium text-gray-700 mb-2'
                  >Kriteria tahun Pengalaman</label>
                  <div class='flex items-center space-x-8'>
                    <div class='flex items-center'>
                      <input
                        id='exp-1'
                        name='pengalaman'
                        type='radio'
                        class='h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500'
                      />
                      <label
                        for='exp-1'
                        class='ml-2 block text-sm text-gray-700'
                      >&lt; 1 tahun</label>
                    </div>
                    <div class='flex items-center'>
                      <input
                        id='exp-2'
                        name='pengalaman'
                        type='radio'
                        class='h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500'
                      />
                      <label
                        for='exp-2'
                        class='ml-2 block text-sm text-gray-700'
                      >1 tahun</label>
                    </div>
                    <div class='flex items-center'>
                      <input
                        id='exp-3'
                        name='pengalaman'
                        type='radio'
                        class='h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500'
                      />
                      <label
                        for='exp-3'
                        class='ml-2 block text-sm text-gray-700'
                      >2 tahun</label>
                    </div>
                    <div class='flex items-center'>
                      <input
                        id='exp-4'
                        name='pengalaman'
                        type='radio'
                        class='h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500'
                      />
                      <label
                        for='exp-4'
                        class='ml-2 block text-sm text-gray-700'
                      >3-4 tahun</label>
                    </div>
                  </div>
                </div>

                <div>
                  <label
                    for='gaji'
                    class='block text-sm font-medium text-gray-700 mb-1'
                  >Gaji</label>
                  <input
                    type='text'
                    id='gaji'
                    placeholder='Masukan gaji'
                    class='w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                  />
                </div>
              </div>

              <div class='md:col-span-2'>
                <label
                  for='deskripsi'
                  class='block text-sm font-medium text-gray-700 mb-1'
                >Deskripsi pekerjaan</label>
                <textarea
                  id='deskripsi'
                  rows='5'
                  placeholder='Masukan deskripsi'
                  class='w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                ></textarea>
              </div>

              <div class='md:col-span-2'>
                <label
                  for='kualifikasi'
                  class='block text-sm font-medium text-gray-700 mb-1'
                >Kualifikasi</label>
                <textarea
                  id='kualifikasi'
                  rows='5'
                  placeholder='Masukan kualifikasi'
                  class='w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                ></textarea>
              </div>

            </div>
          </div>

        </div>
      </main>
    </div>

    <script>
      lucide.createIcons();
    </script>
  </body>
</html>