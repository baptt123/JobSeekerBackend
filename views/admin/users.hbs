<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Quản lý Người dùng | TechConnect Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> admin_sidebar activePage='users'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-8">
    <div>
      <h1 class="text-xl font-bold text-slate-800">Danh sách Người dùng</h1>
      <p class="text-sm text-slate-500 mt-1">Quản lý tài khoản và phân quyền hệ thống</p>
    </div>
    <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-semibold border border-slate-200">
          Tổng thành viên: {{pagination.total}}
        </span>
    </div>
  </header>

  <div class="flex-1 overflow-y-auto p-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase tracking-wider">Thông tin</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase tracking-wider">Liên hệ</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase tracking-wider">Điều chỉnh quyền</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase tracking-wider">Trạng thái</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Hành động</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
        {{#each users}}
          <tr class="hover:bg-slate-50 transition group">
            <td class="p-5">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full border border-slate-200 overflow-hidden flex-shrink-0 bg-slate-100">
                  <img src="{{this.avatar_url}}" onerror="this.src='https://ui-avatars.com/api/?name={{this.full_name}}&background=random'" class="w-full h-full object-cover">
                </div>
                <div>
                  <p class="font-bold text-slate-800 text-sm">{{this.full_name}}</p>
                  <p class="text-xs text-slate-500 font-mono">ID: #{{this.user_id}}</p>
                </div>
              </div>
            </td>

            <td class="p-5 text-sm text-slate-600">
              <div class="flex flex-col gap-1">
                <span class="flex items-center gap-1">
                   <span class="material-symbols-outlined text-[14px] text-slate-400">mail</span> {{this.email}}
                </span>
                {{#if this.phone}}
                  <span class="flex items-center gap-1 text-xs text-slate-500">
                        <span class="material-symbols-outlined text-[14px] text-slate-400">call</span> {{this.phone}}
                  </span>
                {{/if}}
              </div>
            </td>

            <td class="p-5">
              <div class="relative w-40">
                <select onchange="changeRole({{this.user_id}}, this.value)" class="w-full text-xs font-medium border border-slate-300 rounded-lg px-2 py-1.5 focus:ring-2 focus:ring-blue-500 outline-none bg-white text-slate-700 cursor-pointer hover:border-blue-400 transition shadow-sm appearance-none pr-8">
                  <option value="2" {{#if (eq this.role.role_id 2)}}selected{{/if}}>Ứng viên</option>
                  <option value="3" {{#if (eq this.role.role_id 3)}}selected{{/if}}>Nhà tuyển dụng</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500">
                  <span class="material-symbols-outlined text-sm">expand_more</span>
                </div>
              </div>
            </td>

            <td class="p-5">
              {{#if this.deleted_at}}
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 text-red-600 border border-red-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Đã khóa
                </span>
              {{else}}
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-green-50 text-green-600 border border-green-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Hoạt động
                </span>
              {{/if}}
            </td>

            <td class="p-5 text-right">
              <div class="flex justify-end gap-2">
                {{#if this.deleted_at}}
                  <button onclick="restoreUser({{this.user_id}})" class="flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-green-700 bg-green-50 hover:bg-green-100 border border-green-200 rounded-lg transition" title="Mở khóa tài khoản">
                    <span class="material-symbols-outlined text-[16px]">lock_open</span> Mở khóa
                  </button>
                {{else}}
                  <button onclick="deleteUser({{this.user_id}})" class="flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition" title="Khóa tài khoản">
                    <span class="material-symbols-outlined text-[16px]">lock</span> Khóa
                  </button>
                {{/if}}
              </div>
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    {{#if (gt pagination.totalPages 1)}}
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6 border-t border-slate-200 pt-4">
        <p class="text-sm text-slate-500">
          Trang <span class="font-bold text-slate-900">{{pagination.currentPage}}</span> / <span class="font-bold text-slate-900">{{pagination.totalPages}}</span>
        </p>

        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
        <a href="{{#if pagination.hasPrev}}?page={{pagination.prevPage}}{{else}}#{{/if}}" class="relative inline-flex items-center rounded-l-md px-3 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 {{#unless pagination.hasPrev}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_left</span>
          </a>

          <div class="flex overflow-x-auto max-w-[200px] sm:max-w-xs scrollbar-hide border-y border-gray-300">
            {{#each pagination.pages}}
              <a href="?page={{this}}" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold focus:z-20 focus:outline-offset-0 border-x border-gray-300 {{#if (eq this ../pagination.currentPage)}} z-10 bg-blue-600 text-white {{else}} text-gray-900 hover:bg-gray-50 {{/if}}">
              {{this}}
              </a>
            {{/each}}
          </div>

          <a href="{{#if pagination.hasNext}}?page={{pagination.nextPage}}{{else}}#{{/if}}" class="relative inline-flex items-center rounded-r-md px-3 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 {{#unless pagination.hasNext}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_right</span>
          </a>
        </nav>
      </div>
    {{/if}}
  </div>
</main>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
  const showToast = (msg, type = 'success') => {
    Toastify({
      text: msg,
      duration: 3000,
      gravity: "top",
      position: "right",
      style: { background: type === 'success' ? "linear-gradient(to right, #00b09b, #96c93d)" : "#ef4444" }
    }).showToast();
  }

  async function changeRole(userId, newRoleId) {
    const result = await Swal.fire({
      title: 'Xác nhận thay đổi?',
      text: "Bạn có chắc chắn muốn thay đổi quyền hạn của người dùng này?",
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#3b82f6',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Xác nhận',
      cancelButtonText: 'Hủy'
    });
    if (!result.isConfirmed) {
      window.location.reload();
      return;
    }

    try {
      const response = await axios.patch(`/admin/users/${userId}/role`, { roleId: Number(newRoleId) });
      if (response.status === 200 || response.status === 201) {
        showToast('✅ Cập nhật quyền thành công!');
        setTimeout(() => window.location.reload(), 1000);
      }
    } catch (error) {
      const msg = error.response?.data?.message || 'Có lỗi xảy ra';
      showToast('❌ Lỗi: ' + msg, 'error');
    }
  }

  async function deleteUser(id) {
    const result = await Swal.fire({
      title: 'Khóa tài khoản?',
      text: "Người dùng này sẽ bị KHÓA và không thể đăng nhập.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Khóa ngay'
    });
    if (result.isConfirmed) {
      try {
        await axios.delete(`/admin/users/${id}`);
        showToast('Đã khóa tài khoản thành công');
        setTimeout(() => window.location.reload(), 1000);
      } catch(e) {
        showToast('Lỗi: ' + (e.response?.data?.message || e.message), 'error');
      }
    }
  }

  async function restoreUser(id) {
    const result = await Swal.fire({
      title: 'Mở khóa tài khoản?',
      text: "Bạn có chắc muốn MỞ KHÓA cho tài khoản này?",
      icon: 'info',
      showCancelButton: true,
      confirmButtonColor: '#22c55e',
      confirmButtonText: 'Mở khóa'
    });
    if (result.isConfirmed) {
      try {
        await axios.post(`/admin/users/${id}/restore`);
        showToast('Đã mở khóa tài khoản');
        setTimeout(() => window.location.reload(), 1000);
      } catch(e) {
        showToast('Lỗi: ' + (e.response?.data?.message || e.message), 'error');
      }
    }
  }
</script>
</body>
</html>