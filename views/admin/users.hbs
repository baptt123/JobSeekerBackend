<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Users - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900">

<div class="flex h-screen overflow-hidden">
  <aside class="w-64 bg-slate-900 text-white flex flex-col shadow-xl z-20">
    <div class="h-16 flex items-center px-6 border-b border-slate-700 bg-slate-900">
      <span class="material-symbols-outlined text-teal-400 text-3xl mr-2">admin_panel_settings</span>
      <span class="text-lg font-bold">Admin Portal</span>
    </div>
    <nav class="flex-1 px-4 py-6 space-y-2">
      <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 rounded-lg transition-colors">
        <span class="material-symbols-outlined">dashboard</span> Dashboard
      </a>
      <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 bg-teal-600/20 text-teal-400 rounded-lg transition-colors">
        <span class="material-symbols-outlined">group</span> Users
      </a>
      <a href="/admin/companies" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 rounded-lg transition-colors">
        <span class="material-symbols-outlined">apartment</span> Companies
      </a>
    </nav>
  </aside>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm">
      <h1 class="text-xl font-bold text-slate-800">User Management (Total: {{total}})</h1>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="p-4 text-sm font-semibold text-slate-600">ID</th>
            <th class="p-4 text-sm font-semibold text-slate-600">User Info</th>
            <th class="p-4 text-sm font-semibold text-slate-600">Status</th>
            <th class="p-4 text-sm font-semibold text-slate-600">Role Action</th>
            <th class="p-4 text-sm font-semibold text-slate-600 text-right">Ban/Restore</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
          {{#each users}}
            <tr class="hover:bg-slate-50 transition {{#if this.deleted_at}}bg-red-50{{/if}}">
              <td class="p-4 text-slate-500">#{{this.user_id}}</td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-slate-200 bg-cover bg-center" style="background-image: url('{{this.avatar_url}}')"></div>
                  <div>
                    <p class="font-medium text-slate-900">{{this.full_name}}</p>
                    <p class="text-xs text-slate-500">{{this.email}}</p>
                  </div>
                </div>
              </td>
              <td class="p-4">
                {{#if this.deleted_at}}
                  <span class="px-2 py-1 rounded text-xs font-bold bg-red-100 text-red-700">BANNED</span>
                {{else}}
                  <span class="px-2 py-1 rounded text-xs font-bold bg-green-100 text-green-700">ACTIVE</span>
                {{/if}}
              </td>
              <td class="p-4">
                <select onchange="changeRole({{this.user_id}}, this.value)" class="text-xs border border-slate-300 rounded px-2 py-1 focus:ring-teal-500">
                  <option value="2" {{#if (eq this.role_id 2)}}selected{{/if}}>Candidate</option>
                  <option value="3" {{#if (eq this.role_id 3)}}selected{{/if}}>Recruiter</option>
                  <option value="1" {{#if (eq this.role_id 1)}}selected{{/if}}>Admin</option>
                </select>
              </td>
              <td class="p-4 text-right">
                {{#if this.deleted_at}}
                  <button onclick="restoreUser({{this.user_id}})" class="text-green-600 hover:text-green-800 font-medium text-sm flex items-center justify-end gap-1 ml-auto">
                    <span class="material-symbols-outlined text-lg">settings_backup_restore</span> Restore
                  </button>
                {{else}}
                  <button onclick="banUser({{this.user_id}})" class="text-red-500 hover:text-red-700 font-medium text-sm flex items-center justify-end gap-1 ml-auto">
                    <span class="material-symbols-outlined text-lg">block</span> Ban
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
          </tbody>
        </table>

        <div class="p-4 border-t border-slate-200 flex justify-between items-center bg-slate-50">
          <span class="text-sm text-slate-500">Page {{page}} of {{totalPages}}</span>
          <div class="flex gap-2">
            <a href="/admin/users?page={{subtract page 1}}"
            class="px-3 py-1 border bg-white rounded hover:bg-slate-100 text-sm {{#if (eq page 1)}}pointer-events-none opacity-50{{/if}}">
            Prev
            </a>
            <a href="/admin/users?page={{add page 1}}"
            class="px-3 py-1 border bg-white rounded hover:bg-slate-100 text-sm {{#if (eq page totalPages)}}pointer-events-none opacity-50{{/if}}">
            Next
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  // 1. Hàm Ban User
  async function banUser(id) {
    if(!confirm('Ban this user? They will not be able to login.')) return;
    try {
      const res = await fetch(`/admin/users/${id}`, { method: 'DELETE' });
      if(res.ok) window.location.reload();
    } catch(e) { alert('Error banning user'); }
  }

  // 2. Hàm Restore User
  async function restoreUser(id) {
    if(!confirm('Restore this user?')) return;
    try {
      const res = await fetch(`/admin/users/${id}/restore`, { method: 'PATCH' });
      if(res.ok) window.location.reload();
    } catch(e) { alert('Error restoring user'); }
  }

  // 3. Hàm Đổi Role
  async function changeRole(id, newRole) {
    if(!confirm('Change user role?')) return;
    try {
      const res = await fetch(`/admin/users/${id}/role`, {
        method: 'PATCH',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ roleId: Number(newRole) })
      });
      if(res.ok) {
        alert('Role changed successfully');
        window.location.reload();
      }
    } catch(e) { alert('Error changing role'); }
  }
</script>
</body>
</html>