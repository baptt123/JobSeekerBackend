<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Bảng điều khiển | TechConnect Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>body {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> admin_sidebar activePage='dashboard'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Tổng quan hệ thống</h1>
      <p class="text-sm text-slate-500 mt-1">Xin chào {{user.full_name}}, chúc bạn một ngày làm việc hiệu quả!</p>
    </div>
    <div class="flex items-center gap-3">
         <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Online
        </span>
      <img src="{{user.avatar_url}}" class="w-10 h-10 rounded-full border border-slate-200">
    </div>
  </header>

  <div class="flex-1 overflow-y-auto p-8">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition">
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">group</span>
          </div>
          <h3 class="text-3xl font-bold text-slate-800">{{stats.totalUsers}}</h3>
          <p class="text-sm text-slate-500 font-medium">Người dùng</p>
        </div>
      </div>

      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition">
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">domain</span>
          </div>
          <h3 class="text-3xl font-bold text-slate-800">{{stats.totalCompanies}}</h3>
          <p class="text-sm text-slate-500 font-medium">Doanh nghiệp</p>
        </div>
      </div>

      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition">
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">work</span>
          </div>
          <h3 class="text-3xl font-bold text-slate-800">{{stats.totalJobs}}</h3>
          <p class="text-sm text-slate-500 font-medium">Việc làm</p>
        </div>
      </div>

      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-md transition">
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-2xl">forum</span>
          </div>
          <h3 class="text-3xl font-bold text-slate-800">{{stats.totalComments}}</h3>
          <p class="text-sm text-slate-500 font-medium">Bình luận</p>
        </div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
      <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2">
        <span class="material-symbols-outlined text-blue-500">analytics</span> Biểu đồ tăng trưởng
      </h3>
      <div class="h-80">
        <canvas id="growthChart"></canvas>
      </div>
    </div>

  </div>
</main>

<script>
  // Lấy dữ liệu từ Controller truyền xuống
  const chartData = {{{chartData}}};
  console.log('Chart Data:', chartData);

  const ctx = document.getElementById('growthChart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: chartData.labels, // ['Jan', 'Feb', ...]
      datasets: [
        {
          label: 'Người dùng mới',
          data: chartData.users,
          backgroundColor: '#3b82f6',
          borderRadius: 6,
        },
        {
          label: 'Việc làm mới',
          data: chartData.jobs,
          backgroundColor: '#a855f7',
          borderRadius: 6,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: 'top' } },
      scales: { y: { beginAtZero: true } },
    },
  });
</script>
</body>
</html>