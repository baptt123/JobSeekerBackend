<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Companies - Admin</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900">

<div class="flex h-screen overflow-hidden">

  <aside class="w-64 bg-slate-900 text-white flex flex-col shadow-xl z-20">
    <div class="h-16 flex items-center px-6 border-b border-slate-700 bg-slate-900">
      <span class="material-symbols-outlined text-teal-400 text-3xl mr-2">admin_panel_settings</span>
      <span class="text-lg font-bold tracking-wide">Admin Portal</span>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
      <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 hover:text-white rounded-lg transition-colors">
        <span class="material-symbols-outlined">dashboard</span>
        <span class="font-medium">Dashboard</span>
      </a>

      <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 hover:text-white rounded-lg transition-colors">
        <span class="material-symbols-outlined">group</span>
        <span class="font-medium">Users</span>
      </a>

      <a href="/admin/companies" class="flex items-center gap-3 px-4 py-3 bg-teal-600/20 text-teal-400 rounded-lg transition-colors">
        <span class="material-symbols-outlined">apartment</span>
        <span class="font-medium">Companies</span>
      </a>
    </nav>

    <div class="p-4 border-t border-slate-700">
      <a href="/web/logout" class="flex items-center gap-2 text-sm text-slate-400 hover:text-red-400 transition-colors">
        <span class="material-symbols-outlined text-lg">logout</span> Sign Out
      </a>
    </div>
  </aside>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

    <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shadow-sm z-10">
      <div>
        <h1 class="text-xl font-bold text-slate-800">Company Management</h1>
        <p class="text-xs text-slate-500 mt-1">Manage partner companies and their job postings</p>
      </div>

      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-slate-100 rounded-full text-xs font-semibold text-slate-600">Total: {{total}}</span>
        <button class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2 transition shadow-sm">
          <span class="material-symbols-outlined text-lg">add</span> Add Company
        </button>
      </div>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

        <table class="w-full text-left border-collapse">
          <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="p-4 text-xs uppercase tracking-wider font-bold text-slate-500">ID</th>
            <th class="p-4 text-xs uppercase tracking-wider font-bold text-slate-500">Company Info</th>
            <th class="p-4 text-xs uppercase tracking-wider font-bold text-slate-500">Website</th>
            <th class="p-4 text-xs uppercase tracking-wider font-bold text-slate-500">Active Jobs</th>
            <th class="p-4 text-xs uppercase tracking-wider font-bold text-slate-500 text-right">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
          {{#each companies}}
            <tr class="hover:bg-slate-50 transition group">
              <td class="p-4 text-slate-500 text-sm font-mono">#{{this.company_id}}</td>

              <td class="p-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded bg-white flex items-center justify-center border border-slate-200 shadow-sm overflow-hidden shrink-0">
                    {{#if this.logo_url}}
                      <img src="{{this.logo_url}}" class="w-full h-full object-contain p-0.5" alt="logo">
                    {{else}}
                      <span class="material-symbols-outlined text-slate-300 text-xl">apartment</span>
                    {{/if}}
                  </div>
                  <div class="overflow-hidden">
                    <p class="font-semibold text-slate-800 truncate">{{this.name}}</p>
                    <p class="text-xs text-slate-500 truncate max-w-[200px]" title="{{this.address}}">
                      {{#if this.address}}{{this.address}}{{else}}No address provided{{/if}}
                    </p>
                  </div>
                </div>
              </td>

              <td class="p-4">
                {{#if this.website}}
                  <a href="{{this.website}}" target="_blank" class="text-blue-600 hover:text-blue-800 hover:underline text-sm flex items-center gap-1">
                    Visit <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                  </a>
                {{else}}
                  <span class="text-slate-400 text-sm italic">N/A</span>
                {{/if}}
              </td>

              <td class="p-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                    {{#if (gt this.jobs.length 0)}}bg-green-100 text-green-800{{else}}bg-slate-100 text-slate-600{{/if}}">
                                    {{this.jobs.length}} Jobs
                                </span>
              </td>

              <td class="p-4 text-right">
                <div class="flex justify-end gap-1 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity">
                  <button class="p-1.5 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded transition" title="Edit">
                    <span class="material-symbols-outlined text-lg">edit</span>
                  </button>
                  <button onclick="deleteCompany({{this.company_id}})" class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded transition" title="Delete">
                    <span class="material-symbols-outlined text-lg">delete</span>
                  </button>
                </div>
              </td>
            </tr>
          {{/each}}

          {{#unless companies}}
            <tr>
              <td colspan="5" class="p-8 text-center text-slate-500">
                <div class="flex flex-col items-center">
                  <span class="material-symbols-outlined text-4xl mb-2 text-slate-300">search_off</span>
                  <p>No companies found.</p>
                </div>
              </td>
            </tr>
          {{/unless}}
          </tbody>
        </table>

        <div class="p-4 border-t border-slate-200 flex justify-between items-center bg-slate-50">
          <span class="text-sm text-slate-500">Page <strong>{{page}}</strong> of <strong>{{totalPages}}</strong></span>
          <div class="flex gap-2">
            <a href="/admin/companies?page={{subtract page 1}}"
            class="px-3 py-1.5 border border-slate-300 bg-white rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition
            {{#if (eq page 1)}}pointer-events-none opacity-50{{/if}}">
            Previous
            </a>
            <a href="/admin/companies?page={{add page 1}}"
            class="px-3 py-1.5 border border-slate-300 bg-white rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition
            {{#if (eq page totalPages)}}pointer-events-none opacity-50{{/if}}">
            Next
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  async function deleteCompany(id) {
    if (!confirm('Warning: Deleting this company will also remove ALL associated jobs and applications.\n\nAre you sure you want to proceed?')) {
      return;
    }

    try {
      const response = await fetch(`/admin/companies/${id}`, {
        method: 'DELETE',
      });

      const result = await response.json();

      if (response.ok) {
        // Hiển thị thông báo nhỏ thay vì alert chặn màn hình (tùy chọn)
        alert(result.message || 'Company deleted successfully');
        window.location.reload();
      } else {
        alert('Error: ' + (result.message || 'Failed to delete company'));
      }
    } catch (error) {
      console.error(error);
      alert('Network error occurred. Please try again.');
    }
  }
</script>

</body>
</html>