<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Quản lý Doanh nghiệp | TechConnect Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> admin_sidebar activePage='companies'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-8">
    <h1 class="text-xl font-bold text-slate-800">Doanh nghiệp</h1>
    <div class="flex gap-3 items-center">
      <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-semibold">Tổng: {{pagination.total}}</span>

      <button onclick="showDevMessage()" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 shadow-lg shadow-blue-200 transition flex items-center gap-2">
        <span class="material-symbols-outlined text-sm">add</span> Thêm mới
      </button>
    </div>
  </header>

  <div class="flex-1 overflow-y-auto p-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Công ty</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Địa chỉ</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Website</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Quy mô</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase text-right">Hành động</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
        {{#each companies}}
          <tr class="hover:bg-slate-50 transition">
            <td class="p-5">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-lg border border-slate-200 bg-white flex items-center justify-center p-1">
                  <img src="{{this.logo_url}}" onerror="this.src='https://ui-avatars.com/api/?name={{this.name}}'" class="max-w-full max-h-full object-contain">
                </div>
                <div>
                  <p class="font-bold text-slate-800">{{this.name}}</p>
                  <p class="text-xs text-slate-400">ID: {{this.company_id}}</p>
                </div>
              </div>
            </td>
            <td class="p-5 text-sm text-slate-600 max-w-xs truncate" title="{{this.address}}">
              {{this.address}}
            </td>
            <td class="p-5 text-sm">
              {{#if this.website}}
                <button onclick="showDevMessage()" class="text-blue-600 hover:underline flex items-center gap-1">
                  <span class="material-symbols-outlined text-[16px]">link</span> Truy cập
                </button>
              {{else}}
                <span class="text-slate-400">--</span>
              {{/if}}
            </td>
            <td class="p-5">
              <a href="/admin/jobs?companyId={{this.company_id}}" class="inline-flex items-center gap-1 px-3 py-1 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-full text-xs font-medium border border-indigo-100 transition cursor-pointer" title="Xem danh sách việc làm">
              <span class="material-symbols-outlined text-[14px]">work</span> {{this.jobs.length}} tin
              </a>
            </td>
            <td class="p-5 text-right">
              <button onclick="deleteCompany({{this.company_id}})" class="p-2 text-slate-300 hover:text-red-600 hover:bg-red-50 rounded-lg transition" title="Xóa">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    {{#if (gt pagination.totalPages 1)}}
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6">
        <p class="text-sm text-slate-500">
          Trang <span class="font-bold text-slate-800">{{pagination.currentPage}}</span> / {{pagination.totalPages}}
        </p>
        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm bg-white">
        <a href="{{#if pagination.hasPrev}}?page={{pagination.prevPage}}{{else}}#{{/if}}" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 {{#unless pagination.hasPrev}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_left</span>
          </a>
          <div class="flex overflow-x-auto max-w-[200px] sm:max-w-xs scrollbar-hide">
            {{#each pagination.pages}}
              <a href="?page={{this}}" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 {{#if (eq this ../pagination.currentPage)}} z-10 bg-blue-600 text-white {{else}} text-gray-900 hover:bg-gray-50 {{/if}}">
              {{this}}
              </a>
            {{/each}}
          </div>
          <a href="{{#if pagination.hasNext}}?page={{pagination.nextPage}}{{else}}#{{/if}}" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 {{#unless pagination.hasNext}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_right</span>
          </a>
        </nav>
      </div>
    {{/if}}
  </div>
</main>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
  // [NEW] Hàm hiển thị thông báo phát triển
  function showDevMessage() {
    Toastify({
      text: "🚧 Tính năng đang phát triển",
      duration: 3000,
      gravity: "top",
      position: "right",
      style: {
        background: "linear-gradient(to right, #f59e0b, #d97706)", // Màu cam/vàng cảnh báo
        borderRadius: "8px",
        boxShadow: "0 4px 6px rgba(0,0,0,0.1)"
      },
      onClick: function(){} // Callback after click
    }).showToast();
  }

  async function deleteCompany(id) {
    const result = await Swal.fire({
      title: 'CẢNH BÁO XÓA!',
      text: "Công ty và tất cả tin tuyển dụng sẽ bị ẩn khỏi hệ thống. Bạn có chắc muốn tiếp tục?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Xóa ngay',
      cancelButtonText: 'Hủy bỏ'
    });

    if (result.isConfirmed) {
      try {
        await axios.delete(`/admin/companies/${id}`);
        Toastify({
          text: "✅ Đã xóa công ty thành công",
          duration: 3000,
          gravity: "top",
          position: "right",
          style: { background: "linear-gradient(to right, #00b09b, #96c93d)" }
        }).showToast();
        setTimeout(() => window.location.reload(), 1500);
      } catch(e) {
        Toastify({
          text: "❌ " + e.message,
          duration: 3000,
          gravity: "top",
          position: "right",
          style: { background: "#ef4444" }
        }).showToast();
      }
    }
  }
</script>
</body>
</html>