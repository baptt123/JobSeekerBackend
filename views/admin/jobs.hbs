<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Quản lý Việc làm | TechConnect Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> admin_sidebar activePage='jobs'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-8">
    <h1 class="text-xl font-bold text-slate-800">Tin tuyển dụng</h1>
    <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-semibold">Tổng: {{pagination.total}}</span>
  </header>

  <div class="flex-1 overflow-y-auto p-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Tiêu đề</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Công ty</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Người đăng</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Ngày tạo</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase text-right">Hành động</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
        {{#each jobs}}
          <tr class="hover:bg-slate-50 transition group">
            <td class="p-5">
              <a href="/jobs/{{this.job_id}}" target="_blank" class="font-bold text-slate-800 hover:text-blue-600 mb-1 block">
                {{this.title}}
              </a>
              <div class="flex items-center gap-2">
                <span class="bg-slate-100 border border-slate-200 text-slate-600 px-2 py-0.5 rounded text-[11px] uppercase font-semibold">{{this.job_type}}</span>
                <span class="text-xs text-slate-500">{{this.location}}</span>
              </div>
            </td>
            <td class="p-5 text-sm font-medium text-slate-700">
              {{#if this.company}}
                {{this.company.name}}
              {{else}}
                <span class="text-slate-400 italic">Freelance</span>
              {{/if}}
            </td>
            <td class="p-5 text-sm text-slate-600">
              {{this.postedBy.full_name}}
            </td>
            <td class="p-5 text-sm text-slate-500 whitespace-nowrap">
              {{this.created_at}}
            </td>
            <td class="p-5 text-right">
              <button onclick="deleteJob({{this.job_id}})" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" title="Gỡ bài đăng">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    {{#if (gt pagination.totalPages 1)}}
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6">
        <p class="text-sm text-slate-500">
          Trang <span class="font-bold text-slate-800">{{pagination.currentPage}}</span> / {{pagination.totalPages}}
        </p>
        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm bg-white">
        <a href="{{#if pagination.hasPrev}}?page={{pagination.prevPage}}{{else}}#{{/if}}"
          class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 {{#unless pagination.hasPrev}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_left</span>
          </a>

          <div class="flex overflow-x-auto max-w-[200px] sm:max-w-xs scrollbar-hide">
            {{#each pagination.pages}}
              <a href="?page={{this}}"
              class="relative inline-flex items-center px-4 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300
              {{#if (eq this ../pagination.currentPage)}} z-10 bg-blue-600 text-white {{else}} text-gray-900 hover:bg-gray-50 {{/if}}">
              {{this}}
              </a>
            {{/each}}
          </div>

          <a href="{{#if pagination.hasNext}}?page={{pagination.nextPage}}{{else}}#{{/if}}"
          class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 {{#unless pagination.hasNext}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_right</span>
          </a>
        </nav>
      </div>
    {{/if}}

  </div>
</main>

<script>
  async function deleteJob(id) {
    if(confirm('Bạn có chắc muốn GỠ bài tuyển dụng này không? (Soft Delete)')) {
      try { await axios.delete(`/admin/jobs/${id}`); window.location.reload(); } catch(e) { alert(e.message); }
    }
  }
</script>
</body>
</html>