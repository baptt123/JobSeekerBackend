<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Quản lý Bình luận | TechConnect Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-50 text-slate-900 h-screen flex overflow-hidden">

{{> admin_sidebar activePage='comments'}}

<main class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-8">
    <h1 class="text-xl font-bold text-slate-800">Kiểm duyệt Bình luận</h1>
    <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-semibold">Tổng: {{pagination.total}}</span>
  </header>

  <div class="flex-1 overflow-y-auto p-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Người dùng</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Nội dung</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Tại bài đăng</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Thuộc công ty</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase">Thời gian</th>
          <th class="p-5 text-xs font-bold text-slate-500 uppercase text-right">Xử lý</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
        {{#each comments}}
          <tr class="hover:bg-slate-50 transition group">
            <td class="p-5">
              <div class="flex items-center gap-3">
                <img src="{{this.user.avatar_url}}" onerror="this.src='https://ui-avatars.com/api/?name={{this.user.full_name}}'" class="w-9 h-9 rounded-full object-cover border border-slate-200">
                <div>
                  <p class="font-bold text-slate-800 text-sm">{{this.user.full_name}}</p>
                  <p class="text-xs text-slate-400">ID: {{this.user.user_id}}</p>
                </div>
              </div>
            </td>

            <td class="p-5 max-w-xs">
              <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 text-sm text-slate-600 italic">
                "{{this.content}}"
              </div>
            </td>

            <td class="p-5">
              <a href="/admin/jobs/{{this.job.job_id}}" class="text-sm font-semibold text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1 transition">
                {{this.job.title}}
                <span class="material-symbols-outlined text-[14px]">open_in_new</span>
              </a>
            </td>

            <td class="p-5">
              <div class="flex flex-col">
                  <span class="text-sm font-medium text-slate-700">
                    {{#if this.job.company}}{{this.job.company.name}}{{else}}Tự do{{/if}}
                  </span>
              </div>
            </td>

            <td class="p-5 text-sm text-slate-400 whitespace-nowrap">
              {{formatDate this.createdAt}}
            </td>

            <td class="p-5 text-right">
              <button onclick="deleteComment({{this.id}})" class="p-2 text-slate-300 hover:text-red-500 hover:bg-red-50 rounded-lg transition" title="Xóa bình luận">
                <span class="material-symbols-outlined">delete_forever</span>
              </button>
            </td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>

    {{#if (gt pagination.totalPages 1)}}
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6">
        <p class="text-sm text-slate-500">
          Trang <span class="font-bold text-slate-800">{{pagination.currentPage}}</span> / {{pagination.totalPages}}
        </p>
        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm bg-white">
        <a href="{{#if pagination.hasPrev}}?page={{pagination.prevPage}}{{else}}#{{/if}}" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 {{#unless pagination.hasPrev}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_left</span>
          </a>
          <div class="flex overflow-x-auto max-w-[200px] sm:max-w-xs scrollbar-hide">
            {{#each pagination.pages}}
              <a href="?page={{this}}" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 {{#if (eq this ../pagination.currentPage)}} z-10 bg-blue-600 text-white {{else}} text-gray-900 hover:bg-gray-50 {{/if}}">
              {{this}}
              </a>
            {{/each}}
          </div>
          <a href="{{#if pagination.hasNext}}?page={{pagination.nextPage}}{{else}}#{{/if}}" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 {{#unless pagination.hasNext}}opacity-50 cursor-not-allowed{{/unless}}">
          <span class="material-symbols-outlined text-sm">chevron_right</span>
          </a>
        </nav>
      </div>
    {{/if}}
  </div>
</main>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script>
  async function deleteComment(id) {
    const result = await Swal.fire({
      title: 'CẢNH BÁO ADMIN',
      text: "Bạn có chắc muốn xóa bình luận này?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#64748b',
      confirmButtonText: 'Xóa ngay',
      cancelButtonText: 'Hủy'
    });
    if (result.isConfirmed) {
      try {
        await axios.delete(`/admin/comments/${id}`);
        Toastify({
          text: "✅ Đã xóa bình luận",
          duration: 2000,
          gravity: "top",
          position: "right",
          style: { background: "linear-gradient(to right, #00b09b, #96c93d)", borderRadius: "8px" }
        }).showToast();
        setTimeout(() => window.location.reload(), 1500);
      } catch (e) {
        Toastify({
          text: "❌ Lỗi: " + e.message,
          duration: 3000,
          gravity: "top",
          position: "right",
          style: { background: "#ef4444", borderRadius: "8px" }
        }).showToast();
      }
    }
  }
</script>
</body>
</html>