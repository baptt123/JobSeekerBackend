<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Đăng nhập - Cổng quản trị</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap"
    rel="stylesheet"
  />
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0f172a;
    }
  </style>
</head>
<body class="flex items-center justify-center min-h-screen text-slate-300">
<div
  class="w-full max-w-md p-8 space-y-6 bg-slate-800 rounded-2xl shadow-2xl border border-slate-700"
>
  <div class="text-center">
    <div class="flex justify-center mb-4">
      <div class="p-3 bg-teal-500/10 rounded-full">
        <svg
          class="w-8 h-8 text-teal-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"
          ></path>
        </svg>
      </div>
    </div>
    <h1 class="text-2xl font-bold text-white tracking-wide">
      Chào mừng trở lại
    </h1>
    <p class="text-sm text-slate-400 mt-2">
      Đăng nhập cho Admin & Nhà tuyển dụng
    </p>
  </div>

  {{#if error}}
    <div
      class="p-3 text-sm text-red-200 bg-red-900/50 border border-red-800 rounded-lg text-center"
    >
      {{error}}
    </div>
  {{/if}}

  <form action="/web/login" method="POST" class="space-y-5">
    <div>
      <label class="block mb-1.5 text-sm font-medium text-slate-300"
      >Địa chỉ Email</label
      >
      <input
        type="email"
        name="email"
        required
        placeholder="ten@congty.com"
        class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 text-white placeholder-slate-500 transition"
      />
    </div>

    <div>
      <label class="block mb-1.5 text-sm font-medium text-slate-300"
      >Mật khẩu</label
      >
      <input
        type="password"
        name="password"
        required
        placeholder="••••••••"
        class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 text-white placeholder-slate-500 transition"
      />
    </div>

    <div class="flex items-center justify-between text-sm">
      <label class="flex items-center space-x-2 cursor-pointer">
        <input
          type="checkbox"
          class="w-4 h-4 text-teal-500 bg-slate-900 border-slate-700 rounded focus:ring-teal-500 focus:ring-offset-slate-800"
        />
        <span>Ghi nhớ đăng nhập</span>
      </label>
      <a href="#" class="text-teal-400 hover:text-teal-300 transition"
      >Quên mật khẩu?</a
      >
    </div>

    <button
      type="submit"
      class="w-full py-3 text-white font-bold bg-teal-600 hover:bg-teal-500 rounded-lg transition shadow-lg shadow-teal-500/20"
    >
      Đăng nhập
    </button>
  </form>

  <div
    class="text-center text-xs text-slate-500 mt-6 pt-4 border-t border-slate-700"
  >
    &copy; 2025 Hệ thống TechConnect.
  </div>
</div>
</body>
</html>